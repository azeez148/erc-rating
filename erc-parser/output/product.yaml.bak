          calculation: rt_EmploymentRelatedAddlEmployeeRate_1 if (field_CoverageType_BOPEmploymentRelatedPracticesLiabilityCov != '') else 0.0
          deleted: false
        - name: calc_Rate_1
          description: Rate
          calculation: rt_EmploymentRelatedRate_1 if (field_CoverageType_BOPEmploymentRelatedPracticesLiabilityCov != '') else 0.0
          deleted: false
        - name: calc_DedFactor_1
          description: DedFactor
          calculation: rt_EmploymentRelatedDedFactor_1 if (field_Ded_BOPEmploymentRelatedPracticesLiabilityCov != '') else 0.0
          deleted: false
        - name: calc_NumAddlEmployees_1
          description: NumAddlEmployees
          calculation: 0.0 if (field_NumEmployees_BOPEmploymentRelatedPracticesLiabilityCov <= 25.0) else field_NumEmployees_BOPEmploymentRelatedPracticesLiabilityCov - 25.0
          deleted: false
        - name: calc_calcPremium_1_1
          description: calcPremium_1
          calculation: '1'
          deleted: false
