                deleted: false
              - name: calc_namedPerilsCredit_1
                description: namedPerilsCredit_1
                calculation: (calc_FinalBusnPrsnlPropRate_BOPClassification * calc_NamedPerilsBusnPrsnlPropFactor_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises)
                deleted: false
              - name: calc_Premium_1
                description: Premium
                calculation: ((((calc_FinalBusnPrsnlPropRate_BOPClassification - calc_namedPerilsCredit_1_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) * calc_SpecifiedBPPTemporarilyAwayFromPremisesNamedPerilsFactor_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) * (field_Limit_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises / 100.0) * calc_FunctlBusnPrsnlPropFactor_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) * calc_IRPMFactor_BOP) if ((calc_sbl_BOPNamedPerils_Premium_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises or calc_sbl_BOPNamedPerilsBldg_Premium_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises or calc_sbl_BOPNamedPerilsBusnPrsnlProp_Premium_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) and calc_sbl_BOPFunctlBusnPrsnlPropValtn_Premium_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) else ((((calc_FinalBusnPrsnlPropRate_BOPClassification - calc_namedPerilsCredit_1_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) * calc_SpecifiedBPPTemporarilyAwayFromPremisesNamedPerilsFactor_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) * (field_Limit_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises / 100.0)) * calc_IRPMFactor_BOP) if (calc_sbl_BOPNamedPerils_Premium_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises or calc_sbl_BOPNamedPerilsBldg_Premium_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises or calc_sbl_BOPNamedPerilsBusnPrsnlProp_Premium_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) else (((calc_FinalBusnPrsnlPropRate_BOPClassification * calc_SpecifiedBPPTemporarilyAwayFromPremisesAllRiskFactor_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) * (field_Limit_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises / 100.0) * calc_FunctlBusnPrsnlPropFactor_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) * calc_IRPMFactor_BOP) if (calc_sbl_BOPFunctlBusnPrsnlPropValtn_Premium_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) else (((calc_FinalBusnPrsnlPropRate_BOPClassification * calc_SpecifiedBPPTemporarilyAwayFromPremisesAllRiskFactor_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises) * (field_Limit_BOPSpecifiedBusinessPersonalPropertyTemporarilyAwayFromPremises / 100.0)) * calc_IRPMFactor_BOP)
                deleted: false
