      - name: bOPTheftOfClientsProperty
        label: BOPTheftOfClientsProperty
        description: Theft Of Clients Property Coverage
        risk_name_template: '{{ riskType.label }} {{ number }}'
        fields:
        - name: field_Premium
          label: Premium
          type: computed
          description: Premium
          calculation: calc_Premium_1
          supplemental: true
          optional: true
          deleted: false
        calculations:
        - name: calc_DetailCoverageLimit
          description: DetailCoverageLimit
          calculation: ( bc.risk.descendants(1).filter(type__name='bOPTheftOfClientsPropertyDetail').get(bc.fields.field_CoverageLimit_BOPTheftOfClientsPropertyDetail) if bc.risk.descendants(1).filter(type__name='bOPTheftOfClientsPropertyDetail').count() == 1 else 0 ) if (( bc.risk.descendants(1).filter(type__name='bOPTheftOfClientsPropertyDetail').get(bc.fields.field_CoverageLimit_BOPTheftOfClientsPropertyDetail) if bc.risk.descendants(1).filter(type__name='bOPTheftOfClientsPropertyDetail').count() == 1 else 0 ) != None and ( bc.risk.descendants(1).filter(type__name='bOPTheftOfClientsPropertyDetail').get(bc.fields.field_CoverageLimit_BOPTheftOfClientsPropertyDetail) if bc.risk.descendants(1).filter(type__name='bOPTheftOfClientsPropertyDetail').count() == 1 else 0 ) != '') else 0.0
          deleted: false
        - name: calc_AdditionalEmployeesCount
          description: AdditionalEmployeesCount
          calculation: 0.0 if (calc_NumEmployees_BOPEmployeeDishtyCoverage <= 5.0) else calc_NumEmployees_BOPEmployeeDishtyCoverage - 5.0
          deleted: false
        - name: calc_TheftOfClientsPropFactor
          description: TheftOfClientsPropFactor
          calculation: rt_TheftOfClientsPropFactor
          deleted: false
        - name: calc_BaseRate
          description: BaseRate
          calculation: rt_EmployeeDishtyBaseRate if (calc_DetailCoverageLimit_BOPTheftOfClientsProperty != 0.0) else 0.0
          deleted: false
        - name: calc_AddlEmployeeRate
          description: AddlEmployeeRate
          calculation: rt_EmployeeDishtyAddlEmployeeRate if (calc_DetailCoverageLimit_BOPTheftOfClientsProperty != 0.0) else 0.0
          deleted: false
        - name: calc_AddlEmployeePremium
          description: AddlEmployeePremium
          calculation: (calc_AddlEmployeeRate_BOPTheftOfClientsProperty * calc_CrimeLCM_BOP)
          deleted: false
        - name: calc_FinalAddlEmployeePremium
          description: FinalAddlEmployeePremium
          calculation: calc_AddlEmployeePremium_BOPTheftOfClientsProperty * calc_AdditionalEmployeesCount_BOPTheftOfClientsProperty
          deleted: false
        - name: calc_BasePremium
          description: BasePremium
          calculation: (calc_TheftOfClientsPropFactor_BOPTheftOfClientsProperty * ((calc_BaseRate_BOPTheftOfClientsProperty * calc_CrimeLCM_BOP) + calc_FinalAddlEmployeePremium_BOPTheftOfClientsProperty))
          deleted: false
        - name: calc_AddlLocationRate
          description: AddlLocationRate
          calculation: rt_EmployeeDishtyAddlLocationRate if (calc_DetailCoverageLimit_BOPTheftOfClientsProperty != 0.0) else 0.0
          deleted: false
        - name: calc_employeeDishtyApply_1
          description: employeeDishtyApply_1
          calculation: '1'
          deleted: false
        - name: calc_AdditionalCharge
          description: AdditionalCharge
          calculation: 0.0 if (calc_employeeDishtyApply_1_BOPTheftOfClientsProperty < 2.0) else ((calc_AddlLocationRate_BOPTheftOfClientsProperty * calc_CrimeLCM_BOP) * (calc_employeeDishtyApply_1_BOPTheftOfClientsProperty - 1.0))
          deleted: false
        - name: calc_Premium_2
          description: Premium
          calculation: ((calc_BasePremium_BOPTheftOfClientsProperty + calc_AdditionalCharge_BOPTheftOfClientsProperty) * calc_IRPMFactor_BOP)
          deleted: false
        rate_tables:
        - name: rt_TheftOfClientsPropFactor
          label: TheftOfClientsPropFactor
          sources:
          - name: calc_constantkey_TheftOfClientsPropFactor
            tier_values:
            - Y
            resolution: map
          data_file: TheftOfClientsPropFactor.json
          deleted: false
        - name: rt_EmployeeDishtyBaseRate
          label: EmployeeDishtyBaseRate
          sources:
          - name: calc_DetailCoverageLimit_BOPTheftOfClientsProperty
            tier_values:
            - '5000'
            - '10000'
            - '25000'
            - '50000'
            - '100000'
            resolution: map
          data_file: EmployeeDishtyBaseRate.json
          deleted: false
        - name: rt_EmployeeDishtyAddlEmployeeRate
          label: EmployeeDishtyAddlEmployeeRate
          sources:
          - name: calc_DetailCoverageLimit_BOPTheftOfClientsProperty
            tier_values:
            - '5000'
            - '10000'
            - '25000'
            - '50000'
            - '100000'
            resolution: map
          data_file: EmployeeDishtyAddlEmployeeRate.json
          deleted: false
        - name: rt_EmployeeDishtyAddlLocationRate
          label: EmployeeDishtyAddlLocationRate
          sources:
          - name: calc_DetailCoverageLimit_BOPTheftOfClientsProperty
            tier_values:
            - '5000'
            - '10000'
            - '25000'
            - '50000'
            - '100000'
            resolution: map
          data_file: EmployeeDishtyAddlLocationRate.json
          deleted: false
        items:
        - name: bOPTheftOfClientsProperty
          label: Theft Of Clients Property Coverage
          type: coverage
          presence: mandatory
          variables: []
          premium:
            name: premium
            calculation: calc_Premium
            deleted: false
          limits: []
          deleted: false
        entities_order:
          fields:
          - field_Premium
          calculations:
          - calc_DetailCoverageLimit
          - calc_AdditionalEmployeesCount
          - calc_TheftOfClientsPropFactor
          - calc_BaseRate
          - calc_AddlEmployeeRate
          - calc_AddlEmployeePremium
          - calc_FinalAddlEmployeePremium
          - calc_BasePremium
          - calc_AddlLocationRate
          - calc_employeeDishtyApply_1
          - calc_AdditionalCharge
          - calc_Premium_2
          rate_tables:
          - rt_TheftOfClientsPropFactor
          - rt_EmployeeDishtyBaseRate
          - rt_EmployeeDishtyAddlEmployeeRate
          - rt_EmployeeDishtyAddlLocationRate
          items:
          - bOPTheftOfClientsProperty
        children:
