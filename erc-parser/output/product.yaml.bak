                calculation: calc_EachAdditional1000Over10000LossCost_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage + calc_eachAdditional1000From5000To10000Limit_1_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage * calc_SubLimitForDeductibleLossCostEachAdditional1000From5000To10000_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage + calc_eachAdditional1000UpTo5000Limit_1_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage * calc_SubLimitForDeductibleLossCostEachAdditional1000UpTo5000_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage if ((field_SubLimitForCondominiumAssociationDeductible_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage / 1000.0) > 10.0) else (calc_eachAdditional_1_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage - 5.0) * calc_SubLimitForDeductibleLossCostEachAdditional1000From5000To10000_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage + calc_eachAdditional1000UpTo5000Limit_1_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage * calc_SubLimitForDeductibleLossCostEachAdditional1000UpTo5000_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage if ((field_SubLimitForCondominiumAssociationDeductible_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage / 1000.0) > 5.0 and (field_SubLimitForCondominiumAssociationDeductible_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage / 1000.0) <= 10.0) else (calc_eachAdditional_1_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage - 1.0) * calc_SubLimitForDeductibleLossCostEachAdditional1000UpTo5000_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage if ((field_SubLimitForCondominiumAssociationDeductible_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage / 1000.0) > 1.0 and (field_SubLimitForCondominiumAssociationDeductible_BOPCondoCommlUnitOwnersOptionalLossAssmtCoverage / 1000.0) <= 5.0) else 0.0
                deleted: false
