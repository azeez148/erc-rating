            children:
            - name: bOPBrandsAndLabels
              label: BOPBrandsAndLabels
              description: Brands And Labels
              risk_name_template: '{{ riskType.label }} {{ number }}'
              fields: []
              calculations:
              - name: calc_Factor
                description: Factor
                calculation: rt_BrandsAndLabelsFactor
                deleted: false
              - name: calc_totBPPPremium_1
                description: totBPPPremium_1
                calculation: calc_Premium_BOPClassificationBusnPrsnlPropCoverage if (( bc.risk.descendants(-1).filter(type__name='bOPClassificationBusnPrsnlPropCoverage').count() ) > 0.0) else 0.0
                deleted: false
              - name: calc_Premium_1
                description: Premium
                calculation: ((0.0 - (1.0 - calc_Factor_BOPBrandsAndLabels)) * calc_totBPPPremium_1_BOPBrandsAndLabels)
                deleted: false
              rate_tables:
              - name: rt_BrandsAndLabelsFactor
                label: BrandsAndLabelsFactor
                sources:
                - name: calc_constantkey_BrandsAndLabelsFactor
                  tier_values:
                  - Y
                  resolution: map
                data_file: BrandsAndLabelsFactor.json
                deleted: false
              items:
              - name: bOPBrandsAndLabels
                label: Brands And Labels
                type: coverage
                presence: mandatory
                variables: []
                premium:
                  name: premium
                  calculation: calc_Premium
                  deleted: false
                limits: []
                deleted: false
              entities_order:
                calculations:
                - calc_Factor
                - calc_totBPPPremium_1
                - calc_Premium_1
                rate_tables:
                - rt_BrandsAndLabelsFactor
                items:
                - bOPBrandsAndLabels
              children: []
