              description: PeriodOfRestorationFactor
              calculation: rt_PeriodOfRestorationGreenUpgradesFactor if (field_PeriodOfRestoration_BOPIncreasedCostOfLossAndRelatedExpensesForGreenUpgradesBldg != '') else 0.0
              deleted: false
