              label: Description Of Scheduled Property
              type: string
              description: Description Of Scheduled Property
              supplemental: true
              optional: false
              deleted: false
            - name: field_DescriptionScheduledPropertyOptionB
              label: Description Of All Scheduled Property Included in Limit
              type: string
              description: Description Of All Scheduled Property Included in Limit
              supplemental: true
              optional: false
              deleted: false
            - name: field_PercentInsuranceToExposure
              label: Percentage Of Insurance Exposure for All Items Listed
              type: enum
              description: Percentage Of Insurance Exposure for All Items Listed
              options:
              - name: field_PercentInsuranceToExposure_75ormore
                value: 75% or more
                label: 75% or more
              - name: field_PercentInsuranceToExposure_50to74.9
                value: 50% to 74.9%
                label: 50% to 74.9%
              - name: field_PercentInsuranceToExposure_25to49.9
                value: 25% to 49.9%
                label: 25% to 49.9%
              - name: field_PercentInsuranceToExposure_Under25
                value: Under 25%
                label: Under 25%
              supplemental: true
              optional: false
              deleted: false
              default: field_PercentInsuranceToExposure_75ormore
            calculations:
            - name: calc_InsuranceToExposureFactor
              description: InsuranceToExposureFactor
              calculation: rt_OffPremisesInsuranceToExposureFactor if (field_Option_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentDetail == 'Option B') else 1.0
              deleted: false
            - name: calc_BasePremium
              description: BasePremium
              calculation: (((calc_CollisionLossCosts_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipment * calc_LCM_BOPLocation) * calc_InsuranceToExposureFactor_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentDetail) * (field_Limit_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentDetail / 100.0))
              deleted: false
            - name: calc_AdditionalPremiumCreditBICoverage
              description: AdditionalPremiumCreditBICoverage
              calculation: ((((calc_CollisionLossCosts_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipment * calc_LCM_BOPLocation) * calc_ExtendedBusinessIncomeFactor_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipment) * calc_InsuranceToExposureFactor_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentDetail) * (field_Limit_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentDetail / 100.0))
              deleted: false
            - name: calc_AdditionalPremiumBICoverageNoWaitingPeriod
              description: AdditionalPremiumBICoverageNoWaitingPeriod
              calculation: ((((calc_CollisionLossCosts_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipment * calc_LCM_BOPLocation) * calc_BusinessIncomeNoWaitingPeriodOptionFactor_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipment) * calc_InsuranceToExposureFactor_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentDetail) * (field_Limit_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentDetail / 100.0))
              deleted: false
            - name: calc_Premium
              description: Premium
              calculation: ((calc_BasePremium_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentCollisionCoverage + calc_AdditionalPremiumCreditBICoverage_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentCollisionCoverage + calc_AdditionalPremiumBICoverageNoWaitingPeriod_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentCollisionCoverage) * calc_IRPMFactor_BOP)
              deleted: false
            - name: calc_AdditionalPremiumCreditEndorsements
              description: AdditionalPremiumCreditEndorsements
              calculation: ((((((calc_OTCLossCosts_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipment * calc_LCM_BOPLocation) * calc_FloodCoverageFactor_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipment) * calc_EarthquakeCoverageFactor_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipment) * calc_WindHailExclusionFactor_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipment) * calc_InsuranceToExposureFactor_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentDetail) * (field_Limit_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentDetail / 100.0)) if (calc_sbl_BOPFloodCov_AdditionalPremiumCreditEndorsements_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentOTCCoverage or ( bc.risk.descendants(0).filter(type__name='bOPEQSubLimit').count() ) > 0.0 or ( bc.risk.descendants(0).filter(type__name='bOPEarthquake').count() ) > 0.0 or ( bc.risk.descendants(0).filter(type__name='bOPWindstormOrHailExclusion').count() ) > 0.0) else 0.0
              deleted: false
            rate_tables:
            - name: rt_OffPremisesInsuranceToExposureFactor
              label: OffPremisesInsuranceToExposureFactor
              sources:
              - name: field_PercentInsuranceToExposure_1
                resolution: map
              data_file: OffPremisesInsuranceToExposureFactor.json
              deleted: false
            items:
            - name: bOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentCollisionCoverage
              label: Off-Premises Interruption Of Business - Vehicles And Mobile Equipment Detail Collision Coverage
              type: coverage
              presence: mandatory
              variables: []
              premium:
                name: premium
                calculation: calc_Premium
                deleted: false
              limits: []
              deleted: false
            - name: bOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentOTCCoverage
              label: Off-Premises Interruption Of Business - Vehicles And Mobile Equipment Detail OTC Coverage
              type: coverage
              presence: mandatory
              variables: []
              premium:
                name: premium
                calculation: calc_Premium
                deleted: false
              limits: []
              deleted: false
            entities_order:
              fields:
              - field_Option
              - field_Limit
              - field_DescriptionScheduledPropertyOptionA
              - field_DescriptionScheduledPropertyOptionB
              - field_PercentInsuranceToExposure
              calculations:
              - calc_InsuranceToExposureFactor
              - calc_BasePremium
              - calc_AdditionalPremiumCreditBICoverage
              - calc_AdditionalPremiumBICoverageNoWaitingPeriod
              - calc_Premium
              - calc_AdditionalPremiumCreditEndorsements
              rate_tables:
              - rt_OffPremisesInsuranceToExposureFactor
              items:
              - bOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentCollisionCoverage
              - bOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentOTCCoverage
            children: []
