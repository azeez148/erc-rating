              label: Premises Number
              type: string
              description: Premises Number
              supplemental: true
              optional: true
              deleted: false
            - name: field_BuildingNumber
              label: Building Number
              type: string
              description: Building Number
              supplemental: true
              optional: true
              deleted: false
            - name: field_NumOfMonths
              label: Number Of Months
              type: enum
              description: Number Of Months
              options:
              - name: field_NumOfMonths_6
                value: '6'
                label: '6'
              - name: field_NumOfMonths_9
                value: '9'
                label: '9'
              - name: field_NumOfMonths_18
                value: '18'
                label: '18'
              supplemental: true
              optional: false
              deleted: false
              default: field_NumOfMonths_6
            calculations:
            - name: calc_LimitFactor
              description: LimitFactor
              calculation: rt_BusnIncomeExtraExpenseCovRevisedPerOfIndemnityFactor if (field_NumOfMonths_BOPBusnIncomeAndExtraExpenseCovRevisedPerOfIndemnity != 0.0) else 0.0
              deleted: false
            - name: calc_totBldgPremium_1
              description: totBldgPremium_1
              calculation: calc_Premium_BOPStructureBuildingCoverage if (( bc.risk.descendants(-1).filter(type__name='bOPStructureBuildingCoverage').count() ) > 0.0) else 0.0
              deleted: false
            - name: calc_totBPPPremium_1
              description: totBPPPremium_1
              calculation: '1'
              deleted: false
            - name: calc_modifiedLimitFactor_1
              description: modifiedLimitFactor_1
              calculation: 0.0 - (1.0 - calc_LimitFactor_BOPBusnIncomeAndExtraExpenseCovRevisedPerOfIndemnity) if (calc_LimitFactor_BOPBusnIncomeAndExtraExpenseCovRevisedPerOfIndemnity > 0.0) else 0.0
              deleted: false
            - name: calc_Premium_1
              description: Premium
              calculation: (calc_modifiedLimitFactor_1_BOPBusnIncomeAndExtraExpenseCovRevisedPerOfIndemnity * calc_totBldgPremium_1_BOPBusnIncomeAndExtraExpenseCovRevisedPerOfIndemnity) + (calc_modifiedLimitFactor_1_BOPBusnIncomeAndExtraExpenseCovRevisedPerOfIndemnity * calc_totBPPPremium_1_BOPBusnIncomeAndExtraExpenseCovRevisedPerOfIndemnity)
              deleted: false
            rate_tables:
            - name: rt_BusnIncomeExtraExpenseCovRevisedPerOfIndemnityFactor
              label: BusnIncomeExtraExpenseCovRevisedPerOfIndemnityFactor
              sources:
              - name: field_NumOfMonths_1
                resolution: map
              data_file: BusnIncomeExtraExpenseCovRevisedPerOfIndemnityFactor.json
              deleted: false
            items:
            - name: bOPBusnIncomeAndExtraExpenseCovRevisedPerOfIndemnity
              label: Business Income And Extra Expense - Revised Period Of Indemnity
              type: coverage
              presence: mandatory
              variables: []
              premium:
                name: premium
                calculation: calc_Premium
                deleted: false
