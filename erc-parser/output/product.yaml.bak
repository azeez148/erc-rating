            deleted: false
          - name: calc_EarthquakeCoverageFactor
            description: EarthquakeCoverageFactor
            calculation: rt_OffPremisesEndorsementsModifyingCoveredCOLFactor_1 if (( bc.risk.descendants(1).filter(type__name='bOPEQSubLimit').count() ) > 0.0 or ( bc.risk.descendants(1).filter(type__name='bOPEarthquake').count() ) > 0.0) else 1.0
            deleted: false
          - name: calc_WindHailExclusionFactor
            description: WindHailExclusionFactor
            calculation: rt_OffPremisesEndorsementsModifyingCoveredCOLFactor_2 if (( bc.risk.descendants(1).filter(type__name='bOPWindstormOrHailExclusion').count() ) > 0.0) else 1.0
