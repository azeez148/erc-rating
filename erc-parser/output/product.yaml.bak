            description: Off-Premises Interruption Of Business - Vehicles And Mobile Equipment Detail
            risk_name_template: '{{ riskType.label }} {{ number }}'
            fields:
            - name: field_Option
              label: Choose Option
              type: enum
              description: Choose Option
              options:
              - name: field_Option_OptionA
                value: Option A
                label: Option A
              - name: field_Option_OptionB
