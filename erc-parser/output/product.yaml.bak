      - name: bOPLimitedFungiBacteriaCov
        label: BOPLimitedFungiBacteriaCov
        description: Limited Fungi Or Bacteria Coverage
        risk_name_template: '{{ riskType.label }} {{ number }}'
        fields:
        - name: field_RevisedLimit
          label: 'Revised Limit:'
          type: number
          description: 'Revised Limit:'
          supplemental: true
          optional: true
          deleted: false
        - name: field_SeparatePremisesLocationsOption
          label: 'Separate Premises Or Locations Option:'
          type: enum
          description: 'Separate Premises Or Locations Option:'
          options:
          - name: field_SeparatePremisesLocationsOption_Yes
            value: "Yes"
            label: "Yes"
          - name: field_SeparatePremisesLocationsOption_No
            value: "No"
            label: "No"
          supplemental: true
          optional: false
          deleted: false
          default: field_SeparatePremisesLocationsOption_Yes
        - name: field_DescriptionOfSeparatePremisesLocations
          label: 'If "Yes", describe the separate premises or locations:'
          type: string
          description: 'If "Yes", describe the separate premises or locations:'
          supplemental: true
          optional: true
          deleted: false
        - name: field_SeparateLimitsForEachPremisesOrLocations
          label: 'Separate Limits For Each Premises Or Locations Option:'
          type: enum
          description: 'Separate Limits For Each Premises Or Locations Option:'
          options:
          - name: field_SeparateLimitsForEachPremisesOrLocations_Yes
            value: "Yes"
            label: "Yes"
          - name: field_SeparateLimitsForEachPremisesOrLocations_No
            value: "No"
            label: "No"
          supplemental: true
          optional: true
          deleted: false
          default: field_SeparateLimitsForEachPremisesOrLocations_Yes
        - name: field_Limit
          label: Separate Limits
          type: number
          description: Separate Limits
          supplemental: true
          optional: false
          deleted: false
        - name: field_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage.NumDays
          label: 'Business Income/Extra Expense - Revised Number Of Days:'
          type: enum
          description: 'Business Income/Extra Expense - Revised Number Of Days:'
          options:
          - name: field_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage.NumDays_30
            value: '30'
            label: '30'
          - name: field_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage.NumDays_60
            value: '60'
            label: '60'
          - name: field_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage.NumDays_90
            value: '90'
            label: '90'
          - name: field_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage.NumDays_120
            value: '120'
            label: '120'
          - name: field_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage.NumDays_150
            value: '150'
            label: '150'
          - name: field_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage.NumDays_180
            value: '180'
            label: '180'
          supplemental: true
          optional: false
          deleted: false
          default: field_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage.NumDays_30
        calculations:
        - name: calc_NumDaysFactor
          description: NumDaysFactor
          calculation: rt_FungiNumDaysFactor
          deleted: false
        - name: calc_Premium
          description: Premium
          calculation: 0.0 if (calc_Premium_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage < 0.0) else ((calc_TotBldgPremium_BOP + calc_TotBusnPrsnlPropPremium_BOP) * calc_NumDaysFactor_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage)
          deleted: false
        - name: calc_Rate
          description: Rate
          calculation: rt_FungiExcessLimitRate
          deleted: false
        - name: calc_NumLocations
          description: NumLocations
          calculation: '1'
          deleted: false
        - name: calc_PerPremisesLocationsRate
          description: PerPremisesLocationsRate
          calculation: rt_FungiPerPremisesLocationsRate if (field_SeparatePremisesLocationsOption_BOPLimitedFungiBacteriaCov == 'field_SeparatePremisesLocationsOption_Yes') else 0.0
          deleted: false
        - name: calc_LocationLimitPremium
          description: LocationLimitPremium
          calculation: '1'
          deleted: false
        - name: calc_StructureLimitPremium
          description: StructureLimitPremium
          calculation: '1'
          deleted: false
        - name: calc_NumStructures
          description: NumStructures
          calculation: '1'
          deleted: false
        - name: calc_../../BOPLocation/BOPStructure/FungiExcessLimitPremium
          description: ../../BOPLocation/BOPStructure/FungiExcessLimitPremium
          calculation: '1'
          deleted: false
        - name: calc_LimitPremium
          description: LimitPremium
          calculation: calc_LocationLimitPremium_BOPLimitedFungiBacteriaCovExcessCoverage + calc_StructureLimitPremium_BOPLimitedFungiBacteriaCovExcessCoverage if (field_SeparatePremisesLocationsOption_BOPLimitedFungiBacteriaCov == 'field_SeparatePremisesLocationsOption_1_Yes') else ((calc_Rate_BOPLimitedFungiBacteriaCovExcessCoverage * calc_LCM_BOP) * ((field_Limit_BOPLimitedFungiBacteriaCov - 15000.0) / 100.0)) if (field_SeparatePremisesLocationsOption_BOPLimitedFungiBacteriaCov == 'field_SeparatePremisesLocationsOption_2_No') else 0.0
          deleted: false
        - name: calc_AdditionalPremisesLocationsPremium
          description: AdditionalPremisesLocationsPremium
          calculation: (calc_PerPremisesLocationsRate_BOPLimitedFungiBacteriaCovExcessCoverage * calc_LCM_BOP) * (calc_NumLocations_BOPLimitedFungiBacteriaCovExcessCoverage + calc_NumStructures_BOPLimitedFungiBacteriaCovExcessCoverage - 1.0) if (field_SeparatePremisesLocationsOption_BOPLimitedFungiBacteriaCov == 'field_SeparatePremisesLocationsOption_3_Yes') else 0.0
          deleted: false
        rate_tables:
        - name: rt_FungiNumDaysFactor
          label: FungiNumDaysFactor
          sources:
          - name: field_NumDays
            resolution: map
          data_file: FungiNumDaysFactor.json
          deleted: false
        - name: rt_FungiExcessLimitRate
          label: FungiExcessLimitRate
          sources:
          - name: calc_constantkey_FungiExcessLimitRate
            tier_values:
            - Y
            resolution: map
          data_file: FungiExcessLimitRate.json
          deleted: false
        - name: rt_FungiPerPremisesLocationsRate
          label: FungiPerPremisesLocationsRate
          sources:
          - name: calc_constantkey_FungiPerPremisesLocationsRate
            tier_values:
            - Y
            resolution: map
          data_file: FungiPerPremisesLocationsRate.json
          deleted: false
        items:
        - name: bOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage
          label: Limited Fungi Or Bacteria Business Income Extra Expense Coverage
          type: coverage
          presence: mandatory
          variables: []
          premium:
            name: premium
            calculation: calc_Premium
            deleted: false
          limits: []
          deleted: false
        - name: bOPLimitedFungiBacteriaCovExcessCoverage
          label: Limited Fungi Or Bacteria Excess Coverage
          type: coverage
          presence: mandatory
          variables: []
          premium:
            name: premium
            calculation: calc_Premium
            deleted: false
          limits: []
          deleted: false
        entities_order:
          fields:
          - field_RevisedLimit
          - field_SeparatePremisesLocationsOption
          - field_DescriptionOfSeparatePremisesLocations
          - field_SeparateLimitsForEachPremisesOrLocations
          - field_Limit
          - field_BOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage.NumDays
          calculations:
          - calc_NumDaysFactor
          - calc_Premium
          - calc_Rate
          - calc_NumLocations
          - calc_PerPremisesLocationsRate
          - calc_LocationLimitPremium
          - calc_StructureLimitPremium
          - calc_NumStructures
          - calc_../../BOPLocation/BOPStructure/FungiExcessLimitPremium
          - calc_LimitPremium
          - calc_AdditionalPremisesLocationsPremium
          rate_tables:
          - rt_FungiNumDaysFactor
          - rt_FungiExcessLimitRate
          - rt_FungiPerPremisesLocationsRate
          items:
          - bOPLimitedFungiBacteriaCovBusnIncomeExtraExpenseCoverage
          - bOPLimitedFungiBacteriaCovExcessCoverage
