              deleted: false
            calculations:
            - name: calc_BOPOrdinanceOrLawCov2Coverage/Limit
              description: BOPOrdinanceOrLawCov2Coverage/Limit
              calculation: 0.0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverage 1 Only') else 0.0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverage 3 Only') else 0.0 if (field_Limit_BOPOrdinanceOrLawCov2Coverage < 0.0) else 0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverages 1 and 2') else 0.0 if (field_Limit_BOPOrdinanceOrLawCov2Coverage < 0.0) else 0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverages 1, 2 and 3') else 0.0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverage 1 with Coverages 2 and 3 Combined') else 0.0
              deleted: false
            - name: calc_BOPOrdinanceOrLawCov3Coverage/Limit
              description: BOPOrdinanceOrLawCov3Coverage/Limit
              calculation: 10000.0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverage 1 Only') else 10000.0 if (field_Limit_BOPOrdinanceOrLawCov3Coverage < 10000.0) else 0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverage 3 Only') else 10000.0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverages 1 and 2') else 10000.0 if (field_Limit_BOPOrdinanceOrLawCov3Coverage < 10000.0) else 0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverages 1, 2 and 3') else 0.0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverage 1 with Coverages 2 and 3 Combined') else 0.0
              deleted: false
            - name: calc_BOPOrdinanceOrLawCov2And3Coverage/Limit
              description: BOPOrdinanceOrLawCov2And3Coverage/Limit
              calculation: 0.0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverage 1 Only') else 0.0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverage 3 Only') else 0.0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverages 1 and 2') else 0.0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverages 1, 2 and 3') else 10000.0 if (field_Limit_BOPOrdinanceOrLawCov2And3Coverage < 10000.0) else 0 if (field_Coverage_BOPOrdinanceOrLawCov == 'Coverage 1 with Coverages 2 and 3 Combined') else 0.0
              deleted: false
            - name: calc_Factor
              description: Factor
              calculation: rt_OrdinanceOrLawCov1Factor
              deleted: false
            - name: calc_Premium
              description: Premium
              calculation: (calc_Factor_BOPOrdinanceOrLawCov1Coverage * calc_Premium_BOPStructureBuildingCoverage)
              deleted: false
