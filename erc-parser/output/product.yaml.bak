          - name: calc_baseRateToUse_1
            description: baseRateToUse_1
            calculation: calc_BaseRateRABOP_BOPStructureLiabMedExpensesBldgCoverage if (field_RABOPWanted_BOPStructure == 'field_RABOPWanted_Yes' and (field_RABOPTypeLiabilityLessors_BOPStructure == 'field_RABOPTypeLiabilityLessors_Smoothed' or field_RABOPTypeLiabilityLessors_BOPStructure == 'field_RABOPTypeLiabilityLessors_1_Unsmoothed')) else calc_BaseRate_BOPStructureLiabMedExpensesBldgCoverage
            deleted: false
          - name: calc_CombinedBaseRate
            description: CombinedBaseRate
            calculation: calc_baseRateToUse_1_BOPStructureLiabMedExpensesBldgCoverage * calc_ClassGroupFactor_BOPStructureLiabMedExpensesBldgCoverage
            deleted: false
          - name: calc_FinalRate
            description: FinalRate
            calculation: (calc_CombinedBaseRate_BOPStructureLiabMedExpensesBldgCoverage * calc_LCM_BOPStructure * calc_IncrLimitFactor_BOPStructureLiabMedExpensesBldgCoverage * calc_propDamageLiabDedFactor_BOPStructureLiabMedExpensesBldgCoverage)
            deleted: false
          - name: calc_totalArea_1
            description: totalArea_1
            calculation: '1'
            deleted: false
          - name: calc_TotalArea
            description: TotalArea
            calculation: calc_totalArea_1_BOPStructureLiabMedExpensesBldgCoverage if (calc_structBuildingLimit_BOPStructureLiabMedExpensesBldgCoverage > 0.0 and field_PropertyType_BOPStructure == 'field_PropertyType_Office Condominium') else 0.0
