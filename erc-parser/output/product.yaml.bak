          - name: field_BOPEquipmentBreakdownProtectionCoverage.OptionalTimeDed_24
            value: '24'
            label: '24'
          - name: field_BOPEquipmentBreakdownProtectionCoverage.OptionalTimeDed_48
            value: '48'
            label: '48'
          - name: field_BOPEquipmentBreakdownProtectionCoverage.OptionalTimeDed_72
            value: '72'
            label: '72'
          - name: field_BOPEquipmentBreakdownProtectionCoverage.OptionalTimeDed_120
            value: '120'
            label: '120'
          supplemental: true
          optional: false
          deleted: false
          default: field_BOPEquipmentBreakdownProtectionCoverage.OptionalTimeDed_0
        - name: field_EmployeeDishtyApply
          label: Included
