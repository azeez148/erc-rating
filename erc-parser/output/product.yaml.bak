      calculations:
      - name: calc_State
        description: State
        calculation: '''AL'''
        deleted: false
      - name: calc_IRPMFactor
        description: IRPMFactor
        calculation: 1.0 if (field_IRPMApply_BOP == 'No') else 1.25 if (( bc.risk.descendants(1).filter(type__name='bOPIRPM').get(bc.fields.field_TotalModificationPct_BOPIRPM) if bc.risk.descendants(1).filter(type__name='bOPIRPM').count() == 1 else 0 ) > ( bc.risk.descendants(1).filter(type__name='bOPIRPM').get(bc.calculations.calc_MaxDebit_BOPIRPM) if bc.risk.descendants(1).filter(type__name='bOPIRPM').count() == 1 else 0 )) else 0.75 if (( bc.risk.descendants(1).filter(type__name='bOPIRPM').get(bc.fields.field_TotalModificationPct_BOPIRPM) if bc.risk.descendants(1).filter(type__name='bOPIRPM').count() == 1 else 0 ) < ( bc.risk.descendants(1).filter(type__name='bOPIRPM').get(bc.calculations.calc_MaxCredit_BOPIRPM) if bc.risk.descendants(1).filter(type__name='bOPIRPM').count() == 1 else 0 )) else (( bc.risk.descendants(1).filter(type__name='bOPIRPM').get(bc.fields.field_TotalModificationPct_BOPIRPM) if bc.risk.descendants(1).filter(type__name='bOPIRPM').count() == 1 else 0 ) / 100.0) + 1.0 if (( bc.risk.descendants(1).filter(type__name='bOPIRPM').count() ) > 0.0) else 1.0
        deleted: false
