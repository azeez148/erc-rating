              description: SprinklerLeakageBuildingPremium
              calculation: ((field_SprinklerLeakageRate_BOPSprinklerLeakageEQExt * calc_Factor_BOPSprinklerLeakageEQExt * calc_DedFactor_BOPLocation) * (field_BuildingLimit_BOPStructure / 100.0) * calc_FunctionalBuildingValuationFactor_BOPSprinklerLeakageEQExt) if (field_RatingBasis_BOPStructure == 'field_RatingBasis_Functional Valuation') else ((field_SprinklerLeakageRate_BOPSprinklerLeakageEQExt * calc_Factor_BOPSprinklerLeakageEQExt * calc_DedFactor_BOPLocation) * (field_BuildingLimit_BOPStructure / 100.0))
