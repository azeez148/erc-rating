              calculation: (calc_calcRatio_1_BOPIncreasedCostOfLossAndRelatedExpensesForGreenUpgradesBldg / calc_IncreasedCostOfLossPercentConverted_BOPIncreasedCostOfLossAndRelatedExpensesForGreenUpgradesBldg) if (field_Limit_BOPIncreasedCostOfLossAndRelatedExpensesForGreenUpgradesBldg > 0.0 and field_IncreasedCostOfLossPct_BOPIncreasedCostOfLossAndRelatedExpensesForGreenUpgradesBldg != '') else 0.0
              deleted: false
