            type: number
            description: Business Income and Extra Expense Annual Aggregate Limit Of Insurance Override
            supplemental: true
            optional: false
            deleted: false
          - name: field_ManualPremium
            label: Manual Premium
            type: number
            description: Manual Premium
            supplemental: true
            optional: false
            deleted: false
          calculations:
          - name: calc_bppLimit_1
            description: bppLimit_1
            calculation: '1'
            deleted: false
          - name: calc_busnPrsnlPropReplmtCostCoverage
            description: busnPrsnlPropReplmtCostCoverage
            calculation: '''BusinessPersonalProperty'' if (calc_bppLimit_1_BOPWaterBackUpAndSumpOverflowLocation > 0.0) else ''Building'''
            deleted: false
          - name: calc_limit
            description: limit
            calculation: '1'
            deleted: false
          - name: calc_Charge
            description: Charge
            calculation: rt_WaterBackUpAndSumpOverflowPerLimitCharge if (field_CoveredPropertyAnnualAggregateLimit_BOPWaterBackUpAndSumpOverflowLocation == "5000" and field_BusinessIncomeExtraExpenseAnnualAggregateLimit_BOPWaterBackUpAndSumpOverflowLocation == "5000") else 0.0
            deleted: false
          - name: calc_Premium_1
            description: Premium
            calculation: (calc_IRPMFactor_BOP * (calc_DedFactor_BOPLocation * (calc_Charge_BOPWaterBackUpAndSumpOverflowLocation * calc_LCM_BOPLocation))) if (field_CoveredPropertyAnnualAggregateLimit_BOPWaterBackUpAndSumpOverflowLocation == "5000" and field_BusinessIncomeExtraExpenseAnnualAggregateLimit_BOPWaterBackUpAndSumpOverflowLocation == "5000") else (field_ManualPremium_BOPWaterBackUpAndSumpOverflowLocation * calc_IRPMFactor_BOP)
            deleted: false
          rate_tables:
          - name: rt_WaterBackUpAndSumpOverflowPerLimitCharge
            label: WaterBackUpAndSumpOverflowPerLimitCharge
            sources:
            - name: calc_busnPrsnlPropReplmtCostCoverage_BOPWaterBackUpAndSumpOverflowLocation
              tier_values:
              - BusinessPersonalProperty
              - Building
              resolution: map
            - name: calc_limit_BOPWaterBackUpAndSumpOverflowLocation
              tier_values:
              - '5000'
              resolution: map
            data_file: WaterBackUpAndSumpOverflowPerLimitCharge.json
            deleted: false
          items:
          - name: bOPWaterBackUpAndSumpOverflowLocation
            label: Water Back-Up And Sump Overflow
            type: coverage
            presence: mandatory
            variables: []
            premium:
              name: premium
              calculation: calc_Premium
              deleted: false
