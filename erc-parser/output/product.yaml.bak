          sources:
          - name: calc_constantkey_EquipmentBreakdownAddlCharge
            tier_values:
            - Y
            resolution: map
          data_file: EquipmentBreakdownAddlCharge.json
          deleted: false
        - name: rt_OptionalPropDamageDedFactors
