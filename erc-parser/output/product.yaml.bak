      - name: bOPHiredNonOwnedAuto
        label: BOPHiredNonOwnedAuto
        description: Hired Auto And Non-Owned Auto Liability
        risk_name_template: '{{ riskType.label }} {{ number }}'
        fields:
        - name: field_BOPHiredNonOwnedAutoHiredCoverage.LiabilityCoverage
          label: Hired Auto Liability Coverage
          type: boolean
          description: Hired Auto Liability Coverage
          supplemental: true
          optional: true
          deleted: false
          default: "false"
        - name: field_BOPHiredNonOwnedAutoNonOwnedCoverage.LiabilityCoverage
          label: Non-Owned Auto Liability Coverage (with Delivery Service)
          type: boolean
          description: Non-Owned Auto Liability Coverage (with Delivery Service)
          supplemental: true
          optional: true
          deleted: false
          default: "false"
        - name: field_BOPHiredNonOwnedAutoNonOwnedCoverage.LiabilityDeliveryCoverage
          label: Non-Owned Auto Liability Coverage (without Delivery Service)
          type: boolean
          description: Non-Owned Auto Liability Coverage (without Delivery Service)
          supplemental: true
          optional: true
          deleted: false
          default: "false"
        calculations:
        - name: calc_IncrLimitFactor
          description: IncrLimitFactor
          calculation: rt_HiredNonownedAutoIncrLimitFactor if (field_EachOccLimit_BOP != 'field_EachOccLimit_300000') else 1.0
          deleted: false
        - name: calc_Rate
          description: Rate
          calculation: rt_HiredAutoRate
          deleted: false
        - name: calc_Premium
          description: Premium
          calculation: (calc_IRPMFactor_BOP * (calc_IncrLimitFactor_BOPHiredNonOwnedAuto * (calc_CommercialAutoLCM_BOP * calc_Rate_BOPHiredNonOwnedAutoHiredCoverage)))
          deleted: false
        rate_tables:
        - name: rt_HiredNonownedAutoIncrLimitFactor
          label: HiredNonownedAutoIncrLimitFactor
          sources:
          - name: field_EachOccLimit_BOP
            resolution: map
          data_file: HiredNonownedAutoIncrLimitFactor.json
          deleted: false
        - name: rt_HiredAutoRate
          label: HiredAutoRate
          sources:
          - name: calc_constantkey_HiredAutoRate
            tier_values:
            - Y
            resolution: map
          data_file: HiredAutoRate.json
          deleted: false
        - name: rt_NonownedAutoRate
          label: NonownedAutoRate
          sources:
          - name: calc_constantkey_NonownedAutoRate
            tier_values:
            - Y
            resolution: map
          data_file: NonownedAutoRate.json
          deleted: false
        - name: rt_NonownedAutoWithoutDeliveryRate
          label: NonownedAutoWithoutDeliveryRate
          sources:
          - name: calc_constantkey_NonownedAutoWithoutDeliveryRate
            tier_values:
            - Y
            resolution: map
          data_file: NonownedAutoWithoutDeliveryRate.json
          deleted: false
        items:
        - name: bOPHiredNonOwnedAutoHiredCoverage
          label: Hired Auto Coverage
          type: coverage
          presence: mandatory
          variables: []
          premium:
            name: premium
            calculation: calc_Premium
            deleted: false
          limits: []
          deleted: false
        - name: bOPHiredNonOwnedAutoNonOwnedCoverage
          label: Non-Owned Auto Coverage
          type: coverage
          presence: mandatory
          variables: []
          premium:
            name: premium
            calculation: calc_Premium
            deleted: false
          limits: []
          deleted: false
        - name: bOPHiredNonOwnedAutoNonOwnedNoDeliveryCoverage
          label: Non-Owned Auto No Delivery Coverage
          type: coverage
          presence: mandatory
          variables: []
          premium:
            name: premium
            calculation: calc_Premium
            deleted: false
          limits: []
          deleted: false
        entities_order:
          fields:
          - field_BOPHiredNonOwnedAutoHiredCoverage.LiabilityCoverage
          - field_BOPHiredNonOwnedAutoNonOwnedCoverage.LiabilityCoverage
          - field_BOPHiredNonOwnedAutoNonOwnedCoverage.LiabilityDeliveryCoverage
          calculations:
          - calc_IncrLimitFactor
          - calc_Rate
          - calc_Premium
          rate_tables:
          - rt_HiredNonownedAutoIncrLimitFactor
          - rt_HiredAutoRate
          - rt_NonownedAutoRate
          - rt_NonownedAutoWithoutDeliveryRate
          items:
          - bOPHiredNonOwnedAutoHiredCoverage
          - bOPHiredNonOwnedAutoNonOwnedCoverage
          - bOPHiredNonOwnedAutoNonOwnedNoDeliveryCoverage
        children: []
      - name: bOPIDFraudExpenseCov
        label: BOPIDFraudExpenseCov
        description: Identity Fraud Expense Coverage
        risk_name_template: '{{ riskType.label }} {{ number }}'
        fields:
        - name: field_AggregateLimit
          label: 'Identity Fraud Expense Aggregate Limit - $25,000 unless otherwise indicated below:'
          type: number
          description: 'Identity Fraud Expense Aggregate Limit - $25,000 unless otherwise indicated below:'
          supplemental: true
          optional: false
          deleted: false
        calculations:
        - name: calc_Rate
          description: Rate
          calculation: rt_IDFraudExpnRate
          deleted: false
        - name: calc_OptnlHigherLmtsRate
          description: OptnlHigherLmtsRate
          calculation: rt_IDFraudExpnOptnlHigherLmtsRate
          deleted: false
        - name: calc_Premium_1
          description: Premium
          calculation: (calc_Rate_BOPIDFraudExpenseCov * calc_LCM_BOP) + ((field_AggregateLimit_BOPIDFraudExpenseCov - 25000.0) / 100.0 * calc_OptnlHigherLmtsRate_BOPIDFraudExpenseCov * calc_IRPMFactor_BOP) if (field_AggregateLimit_BOPIDFraudExpenseCov > 25000.0) else (calc_Rate_BOPIDFraudExpenseCov * calc_LCM_BOP)
          deleted: false
        rate_tables:
        - name: rt_IDFraudExpnRate
          label: IDFraudExpnRate
          sources:
          - name: calc_constantkey_IDFraudExpnRate
            tier_values:
            - Y
            resolution: map
          data_file: IDFraudExpnRate.json
          deleted: false
        - name: rt_IDFraudExpnOptnlHigherLmtsRate
          label: IDFraudExpnOptnlHigherLmtsRate
          sources:
          - name: calc_constantkey_IDFraudExpnOptnlHigherLmtsRate
            tier_values:
            - Y
            resolution: map
          data_file: IDFraudExpnOptnlHigherLmtsRate.json
          deleted: false
        items:
        - name: bOPIDFraudExpenseCov
          label: Identity Fraud Expense Coverage
          type: coverage
          presence: mandatory
          variables: []
          premium:
            name: premium
            calculation: calc_Premium
            deleted: false
          limits: []
          deleted: false
        entities_order:
          fields:
          - field_AggregateLimit
          calculations:
          - calc_Rate
          - calc_OptnlHigherLmtsRate
          - calc_Premium_1
          rate_tables:
          - rt_IDFraudExpnRate
          - rt_IDFraudExpnOptnlHigherLmtsRate
          items:
          - bOPIDFraudExpenseCov
        children: []
