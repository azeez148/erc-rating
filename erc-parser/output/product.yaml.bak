      - name: bOPVeterinariansProflLiab
        label: BOPVeterinariansProflLiab
        description: Veterinarians Professional Liability
        risk_name_template: '{{ riskType.label }} {{ number }}'
        fields:
        - name: field_NumVeterinarians
          label: Number of Veterinarians
          type: number
          description: Number of Veterinarians
          supplemental: true
          optional: false
          deleted: false
        calculations:
        - name: calc_Charge
          description: Charge
          calculation: rt_VeterinariansCharge
          deleted: false
        - name: calc_IncrLimitFactor
          description: IncrLimitFactor
          calculation: rt_VeterinariansIncrLimitFactor if (field_EachOccLimit_BOP != 'field_EachOccLimit_300000') else 1.0
          deleted: false
        - name: calc_Premium_1
          description: Premium
          calculation: (calc_IRPMFactor_BOP * (calc_IncrLimitFactor_BOPVeterinariansProflLiab * (field_NumVeterinarians_BOPVeterinariansProflLiab * (calc_Charge_BOPVeterinariansProflLiab * calc_ProfessionalLiabilityLCM_BOP))))
          deleted: false
        rate_tables:
        - name: rt_VeterinariansCharge
          label: VeterinariansCharge
          sources:
          - name: calc_constantkey_VeterinariansCharge
            tier_values:
            - Y
            resolution: map
          data_file: VeterinariansCharge.json
          deleted: false
        - name: rt_VeterinariansIncrLimitFactor
          label: VeterinariansIncrLimitFactor
          sources:
          - name: field_EachOccLimit_BOP
            resolution: map
          data_file: VeterinariansIncrLimitFactor.json
          deleted: false
        items:
        - name: bOPVeterinariansProflLiab
          label: Veterinarians Professional Liability
          type: coverage
          presence: mandatory
          variables: []
          premium:
            name: premium
            calculation: calc_Premium
            deleted: false
          limits: []
          deleted: false
        entities_order:
          fields:
          - field_NumVeterinarians
          calculations:
          - calc_Charge
          - calc_IncrLimitFactor
          - calc_Premium_1
          rate_tables:
          - rt_VeterinariansCharge
          - rt_VeterinariansIncrLimitFactor
          items:
          - bOPVeterinariansProflLiab
        children: []
