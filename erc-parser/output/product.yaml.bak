        calculation: '1'
        deleted: false
      - name: calc_Premium
        description: Premium
        calculation: (field_Charge_BOPAddlLiabExposuresCoverage * calc_IRPMFactor_BOP)
        deleted: false
      - name: calc_constantkey_BusnIncomeChangesTimePeriodFactor
        calculation: '''Y'''
