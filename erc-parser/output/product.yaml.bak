        - name: bOPFineArts
          label: BOPFineArts
          description: Fine Arts
          risk_name_template: '{{ riskType.label }} {{ number }}'
          fields: []
          calculations:
          - name: calc_ApartmentBuildingsCharge
            description: ApartmentBuildingsCharge
            calculation: rt_FineArtsCharge if (calc_sbl_BOPApartmentBuildings_ApartmentBuildingsCharge_BOPFineArts) else 0.0
            deleted: false
          - name: calc_RestaurantsFineArtsCharge
            description: RestaurantsFineArtsCharge
            calculation: rt_RestaurantFineArts if (calc_sbl_BOPRestaurants_RestaurantsFineArtsCharge_BOPFineArts) else 0.0
            deleted: false
          - name: calc_ApartmentCharge
            description: ApartmentCharge
            calculation: calc_ApartmentBuildingsCharge_BOPFineArts if (calc_ApartmentBuildingsCharge_BOPFineArts >= calc_RestaurantsFineArtsCharge_BOPFineArts) else 0.0 if (calc_sbl_BOPApartmentBuildings_ApartmentCharge_BOPFineArts and calc_sbl_BOPRestaurants_ApartmentCharge_BOPFineArts) else 0.0 if (calc_sbl_BOPApartmentBuildings_ApartmentCharge_BOPFineArts and calc_sbl_BOPRestaurants_ApartmentCharge_BOPFineArts) else calc_ApartmentBuildingsCharge_BOPFineArts if (calc_sbl_BOPApartmentBuildings_ApartmentCharge_BOPFineArts and calc_sbl_BOPRestaurants_ApartmentCharge_BOPFineArts) else 0.0
            deleted: false
          - name: calc_RestaurantCharge
            description: RestaurantCharge
            calculation: 0.0 if (calc_ApartmentBuildingsCharge_BOPFineArts >= calc_RestaurantsFineArtsCharge_BOPFineArts) else calc_RestaurantsFineArtsCharge_BOPFineArts if (calc_sbl_BOPApartmentBuildings_RestaurantCharge_BOPFineArts and calc_sbl_BOPRestaurants_RestaurantCharge_BOPFineArts) else calc_RestaurantsFineArtsCharge_BOPFineArts if (calc_sbl_BOPApartmentBuildings_RestaurantCharge_BOPFineArts and calc_sbl_BOPRestaurants_RestaurantCharge_BOPFineArts) else 0.0 if (calc_sbl_BOPApartmentBuildings_RestaurantCharge_BOPFineArts and calc_sbl_BOPRestaurants_RestaurantCharge_BOPFineArts) else 0.0
            deleted: false
          - name: calc_Charge
            description: Charge
            calculation: calc_ApartmentCharge_BOPFineArts
            deleted: false
          - name: calc_Premium
            description: Premium
            calculation: ((calc_Charge_BOPFineArtsApartmentCoverage * calc_LCM_BOPLocation) * calc_IRPMFactor_BOP)
            deleted: false
          rate_tables:
          - name: rt_FineArtsCharge
            label: FineArtsCharge
            sources:
            - name: calc_constantkey_FineArtsCharge
              tier_values:
              - Y
              resolution: map
            data_file: FineArtsCharge.json
            deleted: false
          - name: rt_RestaurantFineArts
            label: RestaurantFineArts
            sources:
            - name: calc_constantkey_RestaurantFineArts
              tier_values:
              - Y
              resolution: map
            data_file: RestaurantFineArts.json
            deleted: false
          items:
          - name: bOPFineArtsApartmentCoverage
            label: Fine Arts Apartment Coverage
            type: coverage
            presence: mandatory
            variables: []
            premium:
              name: premium
              calculation: calc_Premium
              deleted: false
            limits: []
            deleted: false
          - name: bOPFineArtsRestaurantCoverage
