          description: Included
          options:
          - name: field_EmployeeDishtyApply_NotApplicable
            value: Not Applicable
            label: Not Applicable
          - name: field_EmployeeDishtyApply_Yes
            value: "Yes"
            label: "Yes"
          - name: field_EmployeeDishtyApply_No
            value: "No"
            label: "No"
          supplemental: true
