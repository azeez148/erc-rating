      - name: calc_LCM
        description: LCM
        calculation: rt_BOPLCM
        deleted: false
      - name: calc_BusnIncomeOrdinaryPayrollFactor
        description: BusnIncomeOrdinaryPayrollFactor
        calculation: rt_BusnIncomeOrdinaryPayrollFactor if (field_BusnIncomeOrdinaryPayrollNumDays_BOP != "60" and field_BusnIncomeOrdinaryPayrollNumDays_BOP != '') else 1.0 if (field_BusnIncomeOrdinaryPayrollNumDays_BOP == "60") else 0.0
        deleted: false
      - name: calc_BusnIncomeExtddPeriodFactor
        description: BusnIncomeExtddPeriodFactor
        calculation: rt_BusnIncomeExtddPeriodFactor if (field_BusnIncomeExtddPeriodNumDays_BOP != "60" and field_BusnIncomeExtddPeriodNumDays_BOP != '') else 1.0 if (field_BusnIncomeExtddPeriodNumDays_BOP == "60") else 0.0
        deleted: false
      - name: calc_PropDamageLiabDedFactor
        description: PropDamageLiabDedFactor
        calculation: rt_PropDamageLiabDedFactor if (field_PropDamageLiabDed_BOP != 'No Deductible' and field_PropDamageLiabDed_BOP != '' and field_PropDamageLiabDedType_BOP != 'Not Applicable' and field_PropDamageLiabDedType_BOP != '') else 1.0
        deleted: false
      - name: calc_TotBldgPremium
        description: TotBldgPremium
        calculation: '1'
        deleted: false
      - name: calc_bOPFunctlBusnPrsnlPropValtnCoveragePremium_1
        description: bOPFunctlBusnPrsnlPropValtnCoveragePremium_1
        calculation: '1'
        deleted: false
      - name: calc_TotBusnPrsnlPropPremium
