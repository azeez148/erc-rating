            - name: bOPSpoilgCov
              label: BOPSpoilgCov
              description: Spoilage Coverage
              risk_name_template: '{{ riskType.label }} {{ number }}'
              fields:
              - name: field_PremisesNumber
                label: Premises Number
                type: string
                description: Premises Number
                supplemental: true
                optional: true
                deleted: false
              - name: field_BuildingNumber
                label: Building Number
                type: string
                description: Building Number
                supplemental: true
                optional: true
                deleted: false
              - name: field_Limit
                label: Limit Of Insurance
                type: number
                description: Limit Of Insurance
                supplemental: true
                optional: false
                deleted: false
              - name: field_Ded
                label: Deductible
                type: enum
                description: Deductible
                options:
                - name: field_Ded_500
                  value: '500'
                  label: '500'
                supplemental: true
                optional: false
                deleted: false
                default: field_Ded_500
              - name: field_CoverageType
                label: Causes Of Loss
                type: enum
                description: Causes Of Loss
                options:
                - name: field_CoverageType_BreakdownorContamination
                  value: Breakdown or Contamination
                  label: Breakdown or Contamination
                - name: field_CoverageType_BreakdownorContaminationandPowerOutage
                  value: Breakdown or Contamination and Power Outage
                  label: Breakdown or Contamination and Power Outage
                - name: field_CoverageType_PowerOutage
                  value: Power Outage
                  label: Power Outage
                supplemental: true
                optional: false
                deleted: false
                default: field_CoverageType_BreakdownorContamination
              - name: field_Class
                label: Classification
                type: enum
                description: Classification
                options:
                - name: field_Class_BakeryGoods
                  value: Bakery Goods
                  label: Bakery Goods
                - name: field_Class_CheeseShops
                  value: Cheese Shops
                  label: Cheese Shops
                - name: field_Class_ConvenienceFoodStores
                  value: Convenience Food Stores
                  label: Convenience Food Stores
                - name: field_Class_Delicatessens
                  value: Delicatessens
                  label: Delicatessens
                - name: field_Class_DairyProductsexcludingIceCream
                  value: Dairy Products excluding Ice Cream
                  label: Dairy Products excluding Ice Cream
                - name: field_Class_DairyProductsincludingIceCream
                  value: Dairy Products including Ice Cream
                  label: Dairy Products including Ice Cream
                - name: field_Class_Florists
                  value: Florists
                  label: Florists
                - name: field_Class_FruitsandVegetables
                  value: Fruits and Vegetables
                  label: Fruits and Vegetables
                - name: field_Class_GroceryStores
                  value: Grocery Stores
                  label: Grocery Stores
                - name: field_Class_MeatandPoultryMarkets
                  value: Meat and Poultry Markets
                  label: Meat and Poultry Markets
                - name: field_Class_Pharmaceuticals
                  value: Pharmaceuticals
                  label: Pharmaceuticals
                - name: field_Class_Restaurants
                  value: Restaurants
                  label: Restaurants
                - name: field_Class_Seafood
                  value: Seafood
                  label: Seafood
                - name: field_Class_Supermarkets
                  value: Supermarkets
                  label: Supermarkets
                - name: field_Class_Other
                  value: Other
                  label: Other
                supplemental: true
                optional: false
                deleted: false
                default: field_Class_BakeryGoods
              - name: field_MaintenanceAgreement
                label: Refrigeration Maintenance Agreement
                type: enum
                description: Refrigeration Maintenance Agreement
                options:
                - name: field_MaintenanceAgreement_No
                  value: "No"
                  label: "No"
                - name: field_MaintenanceAgreement_Yes
                  value: "Yes"
                  label: "Yes"
                - name: field_MaintenanceAgreement_NotApplicable
                  value: Not Applicable
                  label: Not Applicable
                supplemental: true
                optional: false
                deleted: false
                default: field_MaintenanceAgreement_No
              - name: field_PerishableStockDesc
                label: 'Description Of Perishable Stock:'
                type: string
                description: 'Description Of Perishable Stock:'
                supplemental: true
                optional: false
                deleted: false
              calculations:
              - name: calc_ClassIndicator
                description: ClassIndicator
                calculation: rt_SpoilageClassIndicator if (field_Class_BOPSpoilgCov != 'Other' and field_Class_BOPSpoilgCov != '') else "0"
                deleted: false
              - name: calc_Rate
                description: Rate
                calculation: rt_SpoilageRate if (calc_ClassIndicator_BOPSpoilgCov != '' and field_CoverageType_BOPSpoilgCov != '' and field_MaintenanceAgreement_BOPSpoilgCov != '') else 0.0 if (field_Class_BOPSpoilgCov != 'Other' and field_Class_BOPSpoilgCov != '') else 0.0
                deleted: false
              - name: calc_Premium_1
                description: Premium
                calculation: (calc_IRPMFactor_BOP * ((field_Limit_BOPSpoilgCov / 100.0) * (calc_Rate_BOPSpoilgCov * calc_CommercialPropertyLCM_BOPClassification)))
                deleted: false
              rate_tables:
              - name: rt_SpoilageClassIndicator
                label: SpoilageClassIndicator
                sources:
                - name: field_Class_1
                  resolution: map
                data_file: SpoilageClassIndicator.json
                deleted: false
              - name: rt_SpoilageRate
                label: SpoilageRate
                sources:
                - name: calc_ClassIndicator_BOPSpoilgCov
                  tier_values:
                  - '1'
                  - '2'
                  - '3'
                  resolution: map
                - name: field_CoverageType_1
                  resolution: map
                - name: field_MaintenanceAgreement_1
                  resolution: map
                data_file: SpoilageRate.json
                deleted: false
              items:
              - name: bOPSpoilgCov
                label: Spoilage Coverage
                type: coverage
                presence: mandatory
                variables: []
                premium:
                  name: premium
                  calculation: calc_Premium
                  deleted: false
                limits: []
                deleted: false
              entities_order:
                fields:
                - field_PremisesNumber
                - field_BuildingNumber
                - field_Limit
                - field_Ded
                - field_CoverageType
                - field_Class
                - field_MaintenanceAgreement
                - field_PerishableStockDesc
