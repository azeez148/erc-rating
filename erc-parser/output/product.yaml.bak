          - name: field_CoveredPropertyAnnualAggregateLimit
            label: Covered Property Annual Aggregate Limit Of Insurance
            type: enum
            description: Covered Property Annual Aggregate Limit Of Insurance
            options:
            - name: field_CoveredPropertyAnnualAggregateLimit_Other
              value: Other
              label: Other
            - name: field_CoveredPropertyAnnualAggregateLimit_5000
              value: '5000'
              label: '5000'
            supplemental: true
            optional: false
            deleted: false
            default: field_CoveredPropertyAnnualAggregateLimit_Other
          - name: field_CoveredPropertyAnnualAggregateLimitOverride
