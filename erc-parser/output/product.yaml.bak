          sources:
          - name: calc_constantkey_NonOwnedToolsAndEquipmentRate
            tier_values:
            - Y
            resolution: map
          data_file: NonOwnedToolsAndEquipmentRate.json
          deleted: false
        - name: rt_ContractorsToolsAndEquipmentScheduledBasisRate
          label: ContractorsToolsAndEquipmentScheduledBasisRate
          sources:
          - name: calc_constantkey_ContractorsToolsAndEquipmentScheduledBasisRate
            tier_values:
            - Y
            resolution: map
          data_file: ContractorsToolsAndEquipmentScheduledBasisRate.json
          deleted: false
        items:
        - name: bOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage
          label: Contractors' Tools And Equipment Blanket Coverage
          type: coverage
          presence: mandatory
          variables: []
          premium:
            name: premium
            calculation: calc_Premium
            deleted: false
          limits:
          - name: limit
            label: limit
            type: per_occurrence_limit
            calculation:
              name: limitcalculation
              calculation: field_BOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage.Limit
              deleted: false
            deleted: false
          deleted: false
