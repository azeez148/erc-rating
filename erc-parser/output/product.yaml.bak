            type: enum
            description: Business Income and Extra Expense Annual Aggregate Limit Of Insurance
            options:
            - name: field_BusinessIncomeExtraExpenseAnnualAggregateLimit_Other
              value: Other
              label: Other
            - name: field_BusinessIncomeExtraExpenseAnnualAggregateLimit_5000
              value: '5000'
              label: '5000'
            supplemental: true
            optional: false
            deleted: false
            default: field_BusinessIncomeExtraExpenseAnnualAggregateLimit_Other
