            presence: mandatory
            variables: []
            premium:
              name: premium
              calculation: calc_Premium
              deleted: false
            limits: []
            deleted: false
          entities_order:
            calculations:
            - calc_ApartmentBuildingsCharge
            - calc_RestaurantsFineArtsCharge
            - calc_ApartmentCharge
            - calc_RestaurantCharge
            - calc_Charge
            - calc_Premium
            rate_tables:
            - rt_FineArtsCharge
            - rt_RestaurantFineArts
            items:
            - bOPFineArtsApartmentCoverage
            - bOPFineArtsRestaurantCoverage
          children: []
