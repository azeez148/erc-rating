        risk_name_template: '{{ riskType.label }} {{ number }}'
        fields:
        - name: field_LimitConverted
          label: Total Limit
          type: computed
          description: Total Limit
          calculation: 0 if (1 == 1) else 0
          supplemental: true
          optional: true
          deleted: false
        calculations:
        - name: calc_limit_1
          description: limit_1
          calculation: '1'
          deleted: false
        - name: calc_OTCEachAutoDed
          description: OTCEachAutoDed
          calculation: '1'
          deleted: false
        - name: calc_OTCAnyOneEventDed
          description: OTCAnyOneEventDed
          calculation: '1'
          deleted: false
        - name: calc_CollisionDed
          description: CollisionDed
          calculation: '1'
          deleted: false
        - name: calc_Charge
          description: Charge
          calculation: rt_ApartmentBuildingsTenantsAutosCharge
          deleted: false
        - name: calc_DedFactor
          description: DedFactor
          calculation: rt_ApartmentBuildingsTenantsAutosDedFactor if (calc_OTCEachAutoDed_BOPApartmentBuildingsTotalTenantsAutos != '' and calc_OTCAnyOneEventDed_BOPApartmentBuildingsTotalTenantsAutos != '' and calc_CollisionDed_BOPApartmentBuildingsTotalTenantsAutos != '') else 0.0
          deleted: false
        - name: calc_Premium_1
          description: Premium
          calculation: (((calc_Charge_BOPApartmentBuildingsTotalTenantsAutos * calc_LCM_BOP) * calc_DedFactor_BOPApartmentBuildingsTotalTenantsAutos) * calc_IRPMFactor_BOP)
          deleted: false
        rate_tables:
        - name: rt_ApartmentBuildingsTenantsAutosCharge
          label: ApartmentBuildingsTenantsAutosCharge
          sources:
          - name: field_LimitConverted_BOPApartmentBuildingsTotalTenantsAutos
            tier_values:
            - '6000'
            - '7500'
            - '9000'
            - '12000'
            - '15000'
            - '18000'
            - '22500'
            - '30000'
            - '37500'
            - '45000'
            - '60000'
            - '75000'
            - '90000'
            - '120000'
            - '150000'
            - '180000'
            - '225000'
            - '300000'
            - '375000'
            - '450000'
            - '600000'
            - '750000'
            - '900000'
            - '1200000'
            - '1500000'
            - '2000000'
            - '2500000'
            - '999999999'
            resolution: map
          data_file: ApartmentBuildingsTenantsAutosCharge.json
          deleted: false
        - name: rt_ApartmentBuildingsTenantsAutosDedFactor
          label: ApartmentBuildingsTenantsAutosDedFactor
          sources:
          - name: calc_OTCEachAutoDed_BOPApartmentBuildingsTotalTenantsAutos
            tier_values:
            - '250'
            - '500'
            - '1000'
            resolution: map
          - name: calc_OTCAnyOneEventDed_BOPApartmentBuildingsTotalTenantsAutos
            tier_values:
            - '500'
            - '1000'
            - '2500'
            - Refer To Company
            resolution: map
          - name: calc_CollisionDed_BOPApartmentBuildingsTotalTenantsAutos
            tier_values:
            - '500'
            - '1000'
            resolution: map
          data_file: ApartmentBuildingsTenantsAutosDedFactor.json
          deleted: false
        items:
        - name: bOPApartmentBuildingsTotalTenantsAutos
          label: Apartment Buildings Total Tenants Autos
          type: coverage
          presence: mandatory
          variables: []
          premium:
            name: premium
            calculation: calc_Premium
            deleted: false
          limits: []
          deleted: false
        entities_order:
          fields:
          - field_LimitConverted
          calculations:
          - calc_limit_1
          - calc_OTCEachAutoDed
          - calc_OTCAnyOneEventDed
          - calc_CollisionDed
          - calc_Charge
          - calc_DedFactor
          - calc_Premium_1
          rate_tables:
          - rt_ApartmentBuildingsTenantsAutosCharge
          - rt_ApartmentBuildingsTenantsAutosDedFactor
          items:
          - bOPApartmentBuildingsTotalTenantsAutos
        children: []
