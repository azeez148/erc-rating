          children:
          - name: bOPBusnIncomeAndExtraExpenseCovLOI
            label: BOPBusnIncomeAndExtraExpenseCovLOI
            description: Business Income And Extra Expense Coverage Limit Of Insurance
            risk_name_template: '{{ riskType.label }} {{ number }}'
            fields:
            - name: field_Limit
              label: Business Income, Extra Expense And Related Coverages Limit Of Insurance
              type: enum
              description: Business Income, Extra Expense And Related Coverages Limit Of Insurance
              options:
              - name: field_Limit_100000
                value: '100000'
                label: '100000'
              - name: field_Limit_150000
                value: '150000'
                label: '150000'
              - name: field_Limit_250000
                value: '250000'
                label: '250000'
              supplemental: true
              optional: false
              deleted: false
              default: field_Limit_100000
            - name: field_PremisesNumber
              label: Premises Number
              type: string
              description: Premises Number
              supplemental: true
              optional: true
              deleted: false
            calculations:
            - name: calc_Type
              description: Type
              calculation: '''Offices'' if (field_PropertyType_BOPStructure == ''field_PropertyType_Office'' or field_PropertyType_BOPStructure == ''field_PropertyType_1_Office Condominium'') else ''Contractors'' if (field_PropertyType_BOPStructure == ''field_PropertyType_2_Contractor'') else ''Motels And Residential'' if (field_PropertyType_BOPStructure == ''field_PropertyType_3_Motel'' or field_PropertyType_BOPStructure == ''field_PropertyType_4_Apartment'' or field_PropertyType_BOPStructure == ''field_PropertyType_5_Apartment Condominium Association'') else ''All Other'''
              deleted: false
            - name: calc_BldgLimitFactor
              description: BldgLimitFactor
              calculation: rt_BusnIncomeExtraExpenseCovLOIBldgFactor
              deleted: false
            - name: calc_BPPLimitFactor
              description: BPPLimitFactor
              calculation: rt_BusnIncomeExtraExpenseCovLOIBPPFactor
              deleted: false
            - name: calc_totBldgPremium_1
              description: totBldgPremium_1
              calculation: calc_Premium_BOPStructureBuildingCoverage if (( bc.risk.descendants(-1).filter(type__name='bOPStructureBuildingCoverage').count() ) > 0.0) else 0.0
              deleted: false
            - name: calc_totBPPPremium_1
              description: totBPPPremium_1
              calculation: '1'
              deleted: false
            - name: calc_modifiedBldgLimitFactor_1
              description: modifiedBldgLimitFactor_1
              calculation: 0.0 - (1.0 - calc_BldgLimitFactor_BOPBusnIncomeAndExtraExpenseCovLOI) if (field_Limit_BOPBusnIncomeAndExtraExpenseCovLOI > 0.0) else 0.0
              deleted: false
            - name: calc_modifiedBPPLimitFactor_1
              description: modifiedBPPLimitFactor_1
              calculation: 0.0 - (1.0 - calc_BPPLimitFactor_BOPBusnIncomeAndExtraExpenseCovLOI) if (field_Limit_BOPBusnIncomeAndExtraExpenseCovLOI > 0.0) else 0.0
              deleted: false
            - name: calc_Premium_1
              description: Premium
              calculation: (calc_modifiedBldgLimitFactor_1_BOPBusnIncomeAndExtraExpenseCovLOI * calc_totBldgPremium_1_BOPBusnIncomeAndExtraExpenseCovLOI) + (calc_modifiedBPPLimitFactor_1_BOPBusnIncomeAndExtraExpenseCovLOI * calc_totBPPPremium_1_BOPBusnIncomeAndExtraExpenseCovLOI)
              deleted: false
            rate_tables:
            - name: rt_BusnIncomeExtraExpenseCovLOIBldgFactor
              label: BusnIncomeExtraExpenseCovLOIBldgFactor
              sources:
              - name: field_Limit_1
                resolution: map
              - name: field_Type
                tier_values:
                - Offices
                - Motels And Residential
                - Contractors
                - All Other
                resolution: map
              data_file: BusnIncomeExtraExpenseCovLOIBldgFactor.json
              deleted: false
            - name: rt_BusnIncomeExtraExpenseCovLOIBPPFactor
              label: BusnIncomeExtraExpenseCovLOIBPPFactor
              sources:
              - name: field_Limit_2
                resolution: map
              - name: field_Type_1
                tier_values:
                - Offices
                - Motels And Residential
                - Contractors
                - All Other
                resolution: map
              data_file: BusnIncomeExtraExpenseCovLOIBPPFactor.json
              deleted: false
            items:
            - name: bOPBusnIncomeAndExtraExpenseCovLOI
              label: Business Income And Extra Expense Coverage Limit Of Insurance
              type: coverage
              presence: mandatory
              variables: []
              premium:
                name: premium
                calculation: calc_Premium
                deleted: false
              limits: []
              deleted: false
            entities_order:
              fields:
              - field_Limit
              - field_PremisesNumber
              calculations:
              - calc_Type
              - calc_BldgLimitFactor
              - calc_BPPLimitFactor
              - calc_totBldgPremium_1
              - calc_totBPPPremium_1
              - calc_modifiedBldgLimitFactor_1
              - calc_modifiedBPPLimitFactor_1
              - calc_Premium_1
              rate_tables:
              - rt_BusnIncomeExtraExpenseCovLOIBldgFactor
              - rt_BusnIncomeExtraExpenseCovLOIBPPFactor
              items:
              - bOPBusnIncomeAndExtraExpenseCovLOI
            children: []
          - name: bOPBusnIncomeAndExtraExpenseCovRevisedPerOfIndemnity
