        - name: field_NumEmployees
          label: Number of Employees
          type: number
          description: Number of Employees
          supplemental: true
          optional: false
          deleted: false
        - name: field_ComputerFraudApply
          label: Included
          type: enum
          description: Included
          options:
          - name: field_ComputerFraudApply_NotApplicable
            value: Not Applicable
            label: Not Applicable
          - name: field_ComputerFraudApply_Yes
            value: "Yes"
            label: "Yes"
          - name: field_ComputerFraudApply_No
            value: "No"
            label: "No"
          supplemental: true
          optional: false
          deleted: false
          default: field_ComputerFraudApply_NotApplicable
        - name: field_ComputerFraudNumEmployees
          label: Number of Employees
          type: number
          description: Number of Employees
          supplemental: true
          optional: false
          deleted: false
        - name: field_BOPLocationMoneySecuritiesOnPremCoverage.Limit
          label: On-Premises Limit
          type: number
          description: On-Premises Limit
          supplemental: true
          optional: false
          deleted: false
        - name: field_BOPLocationMoneySecuritiesOffPremCoverage.Limit
          label: Off-Premises Limit
          type: number
          description: Off-Premises Limit
          supplemental: true
          optional: false
          deleted: false
        - name: field_SeparateAnnualAggregateLimit
          label: Separate Annual Aggregate Limit Applies
          type: enum
          description: Separate Annual Aggregate Limit Applies
          options:
          - name: field_SeparateAnnualAggregateLimit_Yes
            value: "Yes"
            label: "Yes"
          - name: field_SeparateAnnualAggregateLimit_No
            value: "No"
            label: "No"
          supplemental: true
          optional: false
          deleted: false
          default: field_SeparateAnnualAggregateLimit_Yes
        - name: field_FungiLimit
          label: Limit
          type: number
          description: Limit
          supplemental: true
          optional: false
          deleted: false
        calculations:
        - name: calc_FungiExcessCovRate
          description: FungiExcessCovRate
          calculation: '1'
          deleted: false
        - name: calc_FungiExcessLimitPremium
          description: FungiExcessLimitPremium
          calculation: ((calc_FungiExcessCovRate_BOPLocation * calc_LCM_BOP) * ((field_FungiLimit_BOPLocation - 15000.0) / 100.0)) if (field_SeparateAnnualAggregateLimit_BOPLocation == 'Yes') else 0.0
          deleted: false
        - name: calc_TotAmountInsurance
          description: TotAmountInsurance
          calculation: '1'
          deleted: false
        - name: calc_TotAmountInsurance_1
          description: TotAmountInsurance
          calculation: '1'
          deleted: false
        - name: calc_WindHailFactor
          description: WindHailFactor
          calculation: rt_WindHailDedFactorWithLOI if (field_OptionalDeductible_BOPLocation != '' and calc_TotAmountInsurance_BOPLocation != 0.0 and field_WindHailDeductible_BOPLocation != '') else 0.0 if (field_WindHailDeductible_BOPLocation != 'Not Applicable') else 1.0
          deleted: false
        - name: calc_OptnlDedFactor
          description: OptnlDedFactor
          calculation: rt_Optnl250FixedDedFactor if (field_OptionalDeductible_BOPLocation == "250") else rt_OptnlFixedDedFactorWithLOI if (field_OptionalDeductible_BOPLocation != '' or calc_TotAmountInsurance_BOPLocation == 0.0) else 0.0
          deleted: false
        - name: calc_DedFactor
          description: DedFactor
          calculation: calc_WindHailFactor_BOPLocation if (calc_WindHailFactor_BOPLocation != 1.0) else calc_OptnlDedFactor_BOPLocation
          deleted: false
        - name: calc_EmployeeDishtyNoChargeLocation
          description: EmployeeDishtyNoChargeLocation
          calculation: '''Yes'' if(bc.risk.descendants(2).filter(type__name=''bOPClassification'').filter(Q(fields__field_ClassDescription_BOPClassification = ''field_ClassDescription_DentalLaboratories'') | Q(fields__field_ClassDescription_BOPClassification = ''field_ClassDescription_1_CopyingandDuplicatingStores'') | Q(fields__field_ClassDescription_BOPClassification = ''field_ClassDescription_2_MailingorAddressingCompaniesDirectMailingCompanies'') | Q(fields__field_ClassDescription_BOPClassification = ''field_ClassDescription_3_MailingorAddressingCompaniesMailingListCompilingServices/MailingListPublishers'')).count() == 1) else '''' if (field_EmployeeDishtyApply_BOPLocation == ''Yes'') else ''No'''
          deleted: false
        - name: calc_TheftOfClientsPropertyEmployeeDishtyApplyCount
          description: TheftOfClientsPropertyEmployeeDishtyApplyCount
          calculation: '1'
          deleted: false
        - name: calc_State
          description: State
          calculation: calc_State_BOP
          deleted: false
        - name: calc_ComputerFraudLimit
          description: ComputerFraudLimit
          calculation: field_Limit_BOPComputerFraudFundsTransferFraudCoverage
          deleted: false
        - name: calc_EmployeeDishtyLimit
          description: EmployeeDishtyLimit
          calculation: field_Limit_BOPEmployeeDishtyCoverage
          deleted: false
        - name: calc_GeneralLiabilityLCM
          description: GeneralLiabilityLCM
          calculation: calc_GeneralLiabilityLCM_BOP
          deleted: false
        - name: calc_CommercialPropertyLCM
          description: CommercialPropertyLCM
          calculation: calc_CommercialPropertyLCM_BOP
          deleted: false
        - name: calc_CrimeLCM
          description: CrimeLCM
          calculation: calc_CrimeLCM_BOP
          deleted: false
        - name: calc_InlandMarineLCM
          description: InlandMarineLCM
          calculation: calc_InlandMarineLCM_BOP
          deleted: false
        - name: calc_BoilerMachineryLCM
          description: BoilerMachineryLCM
          calculation: calc_BoilerMachineryLCM_BOP
          deleted: false
        - name: calc_LCM
          description: LCM
          calculation: calc_LCM_BOP
          deleted: false
        - name: calc_RatingPropertyType
          description: RatingPropertyType
          calculation: bc.risk.descendants(2).filter(type__name='bOPClassification').filter(calculations__calc_LocationMoneyFlag_BOPClassification = 'Yes').get(bc.fields.field_ClassPropertyType_BOPClassification) if(bc.risk.descendants(2).filter(type__name='bOPClassification').filter(calculations__calc_LocationMoneyFlag_BOPClassification = 'Yes').count() == 1) else ''
          deleted: false
        - name: calc_equipmentBreakdownLimit
          description: equipmentBreakdownLimit
          calculation: '1'
          deleted: false
        - name: calc_BaseCharge
          description: BaseCharge
          calculation: rt_EquipmentBreakdownBaseCharge if (calc_equipmentBreakdownLimit_BOPEquipmentBreakdownProtectionCoverage != 0.0) else 0.0 if (calc_equipmentBreakdownLimit_BOPEquipmentBreakdownProtectionCoverage <= 599999.0) else rt_EquipmentBreakdownBaseCharge_1 if (calc_equipmentBreakdownLimit_BOPEquipmentBreakdownProtectionCoverage != 0.0) else 0.0
          deleted: false
        - name: calc_AddlCharge
          description: AddlCharge
          calculation: rt_EquipmentBreakdownAddlCharge
          deleted: false
        - name: calc_OptionalPropDmgDedFactor
          description: OptionalPropDmgDedFactor
          calculation: rt_OptionalPropDamageDedFactors if (field_OptionalPropDamgDed_BOPEquipmentBreakdownProtectionCoverage != 0.0) else 0.0
          deleted: false
        - name: calc_OptionalTimeDedFactor
          description: OptionalTimeDedFactor
          calculation: rt_OptionalTimeDedFactors
          deleted: false
        - name: calc_Each100000AddlCharge
          description: Each100000AddlCharge
          calculation: (calc_AddlCharge_BOPEquipmentBreakdownProtectionCoverage * calc_BoilerMachineryLCM_BOPLocation) * ((calc_equipmentBreakdownLimit_BOPEquipmentBreakdownProtectionCoverage - 599999.0) / 100000.0) if (calc_equipmentBreakdownLimit_BOPEquipmentBreakdownProtectionCoverage > 599999.0) else 0.0
          deleted: false
        - name: calc_Premium
          description: Premium
          calculation: ((((calc_BaseCharge_BOPEquipmentBreakdownProtectionCoverage * calc_BoilerMachineryLCM_BOPLocation) + calc_Each100000AddlCharge_BOPEquipmentBreakdownProtectionCoverage) * calc_OptionalPropDmgDedFactor_BOPEquipmentBreakdownProtectionCoverage) * calc_OptionalTimeDedFactor_BOPEquipmentBreakdownProtectionCoverage)
          deleted: false
        - name: calc_sbl_BOPApartmentBuildings_ApartmentBuildingsCharge_BOPFineArts
          calculation: ( bc.risk.descendants(1).filter(type__name='bOPApartmentBuildings').count() ) > 0
          deleted: false
        - name: calc_sbl_BOPRestaurants_RestaurantsFineArtsCharge_BOPFineArts
          calculation: ( bc.risk.descendants(1).filter(type__name='bOPRestaurants').count() ) > 0
          deleted: false
        - name: calc_sbl_BOPApartmentBuildings_ApartmentCharge_BOPFineArts
          calculation: ( bc.risk.descendants(1).filter(type__name='bOPApartmentBuildings').count() ) > 0
          deleted: false
        - name: calc_sbl_BOPRestaurants_ApartmentCharge_BOPFineArts
          calculation: ( bc.risk.descendants(1).filter(type__name='bOPRestaurants').count() ) > 0
          deleted: false
        - name: calc_sbl_BOPApartmentBuildings_RestaurantCharge_BOPFineArts
          calculation: ( bc.risk.descendants(1).filter(type__name='bOPApartmentBuildings').count() ) > 0
          deleted: false
        - name: calc_sbl_BOPRestaurants_RestaurantCharge_BOPFineArts
          calculation: ( bc.risk.descendants(1).filter(type__name='bOPRestaurants').count() ) > 0
          deleted: false
        - name: calc_InclddLimit
          description: InclddLimit
          calculation: rt_FireDeptServiceInclddLimit
          deleted: false
        - name: calc_Charge
          description: Charge
          calculation: rt_FireDeptServiceCharge if (field_Limit_BOPLocationFireDeptServiceCoverage > calc_InclddLimit_BOPLocationFireDeptServiceCoverage) else 0.0
          deleted: false
        - name: calc_Rate
          description: Rate
          calculation: rt_MoneySecuritiesOffPremisesRate if (field_RatingTerritory_BOPLocation != '' and calc_RatingPropertyType_BOPLocation != '') else 0.0 if (( bc.risk.descendants(2).filter(type__name='bOPClassification').count() ) != 0.0) else 0.0
          deleted: false
        - name: calc_sbl_BOPFloodCov_FloodCoverageFactor_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipment
          calculation: ( bc.risk.descendants(1).filter(type__name='bOPFloodCov').count() ) > 0
          deleted: false
        - name: calc_sbl_BOPFloodCov_AdditionalPremiumCreditEndorsements_BOPOffPremisesInterruptionOfBusinessVehiclesAndMobileEquipmentOTCCoverage
          calculation: ( bc.risk.descendants(1).filter(type__name='bOPFloodCov').count() ) > 0
          deleted: false
        rate_tables:
        - name: rt_WindHailDedFactorWithLOI
          label: WindHailDedFactorWithLOI
          sources:
          - name: field_OptionalDeductible_1
            resolution: map
          - name: calc_TotAmountInsurance_BOPLocation
            tier_values:
            - '50000'
            - '250000'
            - '500000'
            - '1000000'
            - '999999999'
            resolution: map
          - name: field_WindHailDeductible_1
