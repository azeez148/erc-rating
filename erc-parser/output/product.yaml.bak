          description: Premium
          calculation: (((field_ManualBaseRate_BOPCondosCoOpsAssocsDirectorsAndOfficersLiab * (calc_LOIFactor_BOPCondosCoOpsAssocsDirectorsAndOfficersLiab - calc_DedDiscountFactor_BOPCondosCoOpsAssocsDirectorsAndOfficersLiab)) + field_ExtendedReportingPeriodPremium_BOPCondosCoOpsAssocsDirectorsAndOfficersLiab) * calc_IRPMFactor_BOP)
          deleted: false
        - name: calc_LOIFactor_1
          description: LOIFactor
          calculation: rt_CondosDOLOIFactor_1
          deleted: false
        - name: calc_DedDiscountFactor_1
