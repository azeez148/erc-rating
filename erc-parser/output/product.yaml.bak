        description: DaysUntilTRIAExpiration
        calculation: '1'
        deleted: false
      - name: calc_TRIAPreProRateFactor
        description: TRIAPreProRateFactor
        calculation: 0.0 if (calc_DaysUntilTRIAExpiration_BOPTerrorismCoverage == 0.0 and field_TRIAExtended_BOP == 'field_TRIAExtended_No') else 1.0 if ((calc_DaysUntilTRIAExpiration_BOPTerrorismCoverage == 365.0) or (calc_DaysUntilTRIAExpiration_BOPTerrorismCoverage < 365.0 and field_TRIAExtended_BOP == 'field_TRIAExtended_1_Yes')) else (calc_DaysUntilTRIAExpiration_BOPTerrorismCoverage / 365.0)
        deleted: false
      - name: calc_sbl_BOPConditionalExclusionOfTerrorismDispositionOfAct2002_TRIAPostProRateFactor_BOPTerrorismCoverage
        calculation: ( bc.risk.descendants(1).filter(type__name='bOPConditionalExclusionOfTerrorismDispositionOfAct2002').count() ) > 0
        deleted: false
      - name: calc_sbl_BOPConditionalExclusionOfTerrorismNuclearBiologicalChemicalDispositionOfAct2002_TRIAPostProRateFactor_BOPTerrorismCoverage
        calculation: ( bc.risk.descendants(1).filter(type__name='bOPConditionalExclusionOfTerrorismNuclearBiologicalChemicalDispositionOfAct2002').count() ) > 0
        deleted: false
      - name: calc_sbl_BOPConditionalLimitationOfCoverageTerrorismSublimitAnnualAggregateTerrorismAct2002_TRIAPostProRateFactor_BOPTerrorismCoverage
        calculation: ( bc.risk.descendants(1).filter(type__name='bOPConditionalLimitationOfCoverageTerrorismSublimitAnnualAggregateTerrorismAct2002').count() ) > 0
        deleted: false
      - name: calc_TRIAPostProRateFactor
        description: TRIAPostProRateFactor
        calculation: 0.0 if (calc_sbl_BOPConditionalExclusionOfTerrorismDispositionOfAct2002_TRIAPostProRateFactor_BOPTerrorismCoverage or calc_sbl_BOPConditionalExclusionOfTerrorismNuclearBiologicalChemicalDispositionOfAct2002_TRIAPostProRateFactor_BOPTerrorismCoverage or calc_sbl_BOPConditionalLimitationOfCoverageTerrorismSublimitAnnualAggregateTerrorismAct2002_TRIAPostProRateFactor_BOPTerrorismCoverage) else 1.0 if (calc_DaysUntilTRIAExpiration_BOPTerrorismCoverage == 0.0) else 1.0 - calc_TRIAPreProRateFactor_BOPTerrorismCoverage
        deleted: false
      - name: calc_TerrorismBldgPremium
        description: TerrorismBldgPremium
        calculation: '1'
        deleted: false
      - name: calc_TerrorismBPPPremium
        description: TerrorismBPPPremium
        calculation: '1'
        deleted: false
      - name: calc_TerrorismLiabPremium
