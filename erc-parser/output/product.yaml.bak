          label: 1. Blanket Limit
          type: number
          description: 1. Blanket Limit
          supplemental: true
          optional: true
          deleted: false
        - name: field_SubLimitNotInExcess
          label: The applicable per-item sub-limit not in excess of
          type: enum
          description: The applicable per-item sub-limit not in excess of
          options:
          - name: field_SubLimitNotInExcess_500
            value: '500'
            label: '500'
          - name: field_SubLimitNotInExcess_1000
            value: '1000'
            label: '1000'
          - name: field_SubLimitNotInExcess_2000
            value: '2000'
            label: '2000'
          supplemental: true
          optional: false
          deleted: false
          default: field_SubLimitNotInExcess_500
        - name: field_BOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage.ActualCashValueOption
          label: Actual Cash Value Option
          type: enum
          description: Actual Cash Value Option
          options:
          - name: field_BOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage.ActualCashValueOption_Yes
            value: "Yes"
            label: "Yes"
          - name: field_BOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage.ActualCashValueOption_No
            value: "No"
            label: "No"
          supplemental: true
          optional: true
          deleted: false
          default: field_BOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage.ActualCashValueOption_Yes
        - name: field_BOPContrctrsInstalltnToolsAndEquipmtNonOwnedToolsCoverage.Limit
          label: Non-Owned Limit Of Insurance
          type: number
          description: Non-Owned Limit Of Insurance
          supplemental: true
          optional: true
          deleted: false
        - name: field_BOPContrctrsInstalltnToolsAndEquipmtEmployeeToolsCoverage.Limit
          label: Employees' Tools Limit Of Insurance
          type: number
          description: Employees' Tools Limit Of Insurance
          supplemental: true
          optional: true
          deleted: false
        - name: field_DeductibleSelect
          label: 'Deductible:'
          type: enum
          description: 'Deductible:'
          options:
          - name: field_DeductibleSelect_0
            value: '0'
            label: '0'
          - name: field_DeductibleSelect_250
            value: '250'
            label: '250'
          - name: field_DeductibleSelect_500
            value: '500'
            label: '500'
          - name: field_DeductibleSelect_1000
            value: '1000'
            label: '1000'
          - name: field_DeductibleSelect_2500
            value: '2500'
            label: '2500'
          - name: field_DeductibleSelect_5000
            value: '5000'
            label: '5000'
          - name: field_DeductibleSelect_7500
            value: '7500'
            label: '7500'
          - name: field_DeductibleSelect_10000
            value: '10000'
            label: '10000'
          supplemental: true
          optional: true
          deleted: false
          default: field_DeductibleSelect_0
        - name: field_ScheduledLimit
          label: Total Scheduled Property Limit Of Insurance
          type: computed
          description: Total Scheduled Property Limit Of Insurance
          calculation: 0 if (1 == 1) else 0
          supplemental: true
          optional: true
          deleted: false
        calculations:
        - name: calc_limit_1
          description: limit_1
          calculation: '1'
          deleted: false
        - name: calc_TotalLimit
          description: TotalLimit
          calculation: (field_Limit_BOPContrctrsInstalltnToolsAndEquipmtInstalltnCoverage + field_Limit_BOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage + field_ScheduledLimit_BOPContrctrsInstalltnToolsAndEquipmtCov + field_Limit_BOPContrctrsInstalltnToolsAndEquipmtNonOwnedToolsCoverage) + field_Limit_BOPContrctrsInstalltnToolsAndEquipmtEmployeeToolsCoverage
          deleted: false
        - name: calc_DeductibleFactor
          description: DeductibleFactor
          calculation: rt_Optnl250FixedDedFactor if (field_DeductibleSelect_BOPContrctrsInstalltnToolsAndEquipmtCov == "250") else rt_OptnlFixedDedFactorWithLOI if (field_DeductibleSelect_BOPContrctrsInstalltnToolsAndEquipmtCov != "0" and field_DeductibleSelect_BOPContrctrsInstalltnToolsAndEquipmtCov != '') else 1.0
          deleted: false
        - name: calc_Rate
          description: Rate
          calculation: rt_ContractorsToolsAndEquipmentBlanketBasisRate
          deleted: false
        - name: calc_ActualCashValueFactor
          description: ActualCashValueFactor
          calculation: rt_ContractorsToolsAndEquipmentBlanketBasisActualCashValueFactor if (field_ActualCashValueOption_BOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage == 'Yes') else 1.0
          deleted: false
        - name: calc_Premium
          description: Premium
          calculation: (((((calc_Rate_BOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage * calc_InlandMarineLCM_BOP) * calc_DeductibleFactor_BOPContrctrsInstalltnToolsAndEquipmtCov) * (field_Limit_BOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage / 100.0)) * calc_ActualCashValueFactor_BOPContrctrsInstalltnToolsAndEquipmtBlanketToolsCoverage) * calc_IRPMFactor_BOP)
          deleted: false
        rate_tables:
        - name: rt_Optnl250FixedDedFactor
          label: Optnl250FixedDedFactor
          sources:
          - name: calc_constantkey_Optnl250FixedDedFactor
            tier_values:
            - Y
            resolution: map
          data_file: Optnl250FixedDedFactor.json
          deleted: false
        - name: rt_OptnlFixedDedFactorWithLOI
          label: OptnlFixedDedFactorWithLOI
          sources:
          - name: field_DeductibleSelect_1
            resolution: map
          - name: calc_TotalLimit_BOPContrctrsInstalltnToolsAndEquipmtCov
            tier_values:
            - '50000'
            - '250000'
            - '500000'
            - '1000000'
            - '999999999'
            resolution: map
          data_file: OptnlFixedDedFactorWithLOI.json
          deleted: false
        - name: rt_ContractorsToolsAndEquipmentBlanketBasisRate
          label: ContractorsToolsAndEquipmentBlanketBasisRate
          sources:
          - name: field_SubLimitNotInExcess_BOPContrctrsInstalltnToolsAndEquipmtCov
            resolution: map
          data_file: ContractorsToolsAndEquipmentBlanketBasisRate.json
          deleted: false
        - name: rt_ContractorsToolsAndEquipmentBlanketBasisActualCashValueFactor
