          label: Manual Premium
          type: number
          description: Manual Premium
          supplemental: true
          optional: false
          deleted: false
        calculations:
        - name: calc_IncrLimitFactor
          description: IncrLimitFactor
          calculation: rt_EmploymentRelatedIncrLimitFactor if (field_AggLimit_BOPEmploymentRelatedPracticesLiabilityCov != 0.0) else 0.0 if (field_AggLimit_BOPEmploymentRelatedPracticesLiabilityCov != 10000.0) else 1.0
          deleted: false
        - name: calc_AddlEmployeeRate
          description: AddlEmployeeRate
          calculation: rt_EmploymentRelatedAddlEmployeeRate if (field_CoverageType_BOPEmploymentRelatedPracticesLiabilityCov != '') else 0.0
          deleted: false
        - name: calc_Rate
          description: Rate
          calculation: rt_EmploymentRelatedRate if (field_CoverageType_BOPEmploymentRelatedPracticesLiabilityCov != '') else 0.0
          deleted: false
        - name: calc_DedFactor
          description: DedFactor
          calculation: rt_EmploymentRelatedDedFactor if (field_Ded_BOPEmploymentRelatedPracticesLiabilityCov != '') else 0.0
          deleted: false
        - name: calc_NumAddlEmployees
          description: NumAddlEmployees
          calculation: 0.0 if (field_NumEmployees_BOPEmploymentRelatedPracticesLiabilityCov <= 25.0) else field_NumEmployees_BOPEmploymentRelatedPracticesLiabilityCov - 25.0
          deleted: false
        - name: calc_calcPremium_1
          description: calcPremium_1
          calculation: '1'
          deleted: false
        - name: calc_Premium_1
          description: Premium
          calculation: ((calc_calcPremium_1_BOPEmploymentRelatedPracticesLiabilityCov + field_ExtendedReportingPeriodPremium_BOPEmploymentRelatedPracticesLiabilityCov) * calc_IRPMFactor_BOP)
          deleted: false
        - name: calc_IncrLimitFactor_1
          description: IncrLimitFactor
          calculation: rt_EmploymentRelatedIncrLimitFactor_1 if (field_AggLimit_BOPEmploymentRelatedPracticesLiabilityCov != 0.0) else 0.0 if (field_AggLimit_BOPEmploymentRelatedPracticesLiabilityCov != 10000.0) else 1.0
          deleted: false
        - name: calc_AddlEmployeeRate_1
