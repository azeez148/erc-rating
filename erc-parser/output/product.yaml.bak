          calculations:
          - name: calc_RiskCharacteristicInsuredConductsOnlineTransactionsFactor
            description: RiskCharacteristicInsuredConductsOnlineTransactionsFactor
            calculation: rt_RiskCharacteristicInsuredConductsOnlineTransactionsFactor if (field_RiskCharacteristicInsuredConductsOnlineTransactions_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 0.0
            deleted: false
          - name: calc_RiskCharacteristicRemoteAccessToInsuredsComputerSystemFactor
            description: RiskCharacteristicRemoteAccessToInsuredsComputerSystemFactor
            calculation: rt_RiskCharacteristicRemoteAccessToInsuredsComputerSystemsFactor if (field_RiskCharacteristicRemoteAccessToInsuredsComputerSystem_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 0.0
            deleted: false
          - name: calc_RiskCharacteristicInsuredDoesNotHaveWebsiteFactor
            description: RiskCharacteristicInsuredDoesNotHaveWebsiteFactor
            calculation: rt_RiskCharacteristicInsuredDoesNotHaveWebsiteFactor if (field_RiskCharacteristicInsuredDoesNotHaveWebsite_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 0.0
            deleted: false
          - name: calc_RiskCharacteristicInsuredHasActiveSocialMediaProfilesFactor
            description: RiskCharacteristicInsuredHasActiveSocialMediaProfilesFactor
            calculation: rt_RiskCharacteristicInsuredHasActiveSocialMediaProfilesFactor if (field_RiskCharacteristicInsuredHasActiveSocialMediaProfiles_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 0.0
            deleted: false
          - name: calc_RiskCharacteristicInsuredCollectsDataRequiredToBeProtectedFactor
            description: RiskCharacteristicInsuredCollectsDataRequiredToBeProtectedFactor
            calculation: rt_RiskCharacteristicInsuredCollectsDataRequiredByLawToBeProtectedFactor if (field_RiskCharacteristicInsuredCollectsDataRequiredToBeProtected_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 0.0
            deleted: false
          - name: calc_RiskCharacteristicInsuredCollectsInformationOnMinorsFactor
            description: RiskCharacteristicInsuredCollectsInformationOnMinorsFactor
            calculation: rt_RiskCharacteristicInsuredCollectsAndRetainsInformationOnMinorsFactor if (field_RiskCharacteristicInsuredCollectsInformationOnMinors_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 0.0
            deleted: false
          - name: calc_RiskCharacteristicInsuredUtilizesMedicalRecordsInDailyBusinessFactor
            description: RiskCharacteristicInsuredUtilizesMedicalRecordsInDailyBusinessFactor
            calculation: rt_RiskCharacteristicInsuredUtilizesMedicalRecordsInDailyBusinessFactor if (field_RiskCharacteristicInsuredUtilizesMedicalRecordsInDailyBusiness_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 0.0
            deleted: false
          - name: calc_RiskCharacteristicInsuredUtilizesBackgroundAndCreditChecksFactor
            description: RiskCharacteristicInsuredUtilizesBackgroundAndCreditChecksFactor
            calculation: rt_RiskCharacteristicInsuredUtilizesBackgroundAndCreditChecksFactor if (field_RiskCharacteristicInsuredUtilizesBackgroundAndCreditChecks_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 0.0
            deleted: false
          - name: calc_RiskCharacteristicInsuredEmploysEncryptionFactor
            description: RiskCharacteristicInsuredEmploysEncryptionFactor
            calculation: rt_RiskCharacteristicInsuredEmploysEncryptionInCustomerCommunicationsFactor if (field_RiskCharacteristicInsuredEmploysEncryption_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 0.0
            deleted: false
          - name: calc_RiskCharacteristicHighHazardClassificationsFactor
            description: RiskCharacteristicHighHazardClassificationsFactor
            calculation: rt_RiskCharacteristicrHighHazardClassificationsFactor if (field_RiskCharacteristicHighHazardClassifications_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 0.0
            deleted: false
          - name: calc_RiskCharacteristicTotalFactor
            description: RiskCharacteristicTotalFactor
            calculation: (calc_RiskCharacteristicInsuredConductsOnlineTransactionsFactor_BOPInformationSecurityProtectionEndorsementDetail + calc_RiskCharacteristicRemoteAccessToInsuredsComputerSystemFactor_BOPInformationSecurityProtectionEndorsementDetail + calc_RiskCharacteristicInsuredDoesNotHaveWebsiteFactor_BOPInformationSecurityProtectionEndorsementDetail + calc_RiskCharacteristicInsuredHasActiveSocialMediaProfilesFactor_BOPInformationSecurityProtectionEndorsementDetail + calc_RiskCharacteristicInsuredCollectsDataRequiredToBeProtectedFactor_BOPInformationSecurityProtectionEndorsementDetail + calc_RiskCharacteristicInsuredCollectsInformationOnMinorsFactor_BOPInformationSecurityProtectionEndorsementDetail + calc_RiskCharacteristicInsuredUtilizesMedicalRecordsInDailyBusinessFactor_BOPInformationSecurityProtectionEndorsementDetail + calc_RiskCharacteristicInsuredUtilizesBackgroundAndCreditChecksFactor_BOPInformationSecurityProtectionEndorsementDetail + calc_RiskCharacteristicInsuredEmploysEncryptionFactor_BOPInformationSecurityProtectionEndorsementDetail + calc_RiskCharacteristicHighHazardClassificationsFactor_BOPInformationSecurityProtectionEndorsementDetail) + 1.0 if (field_IncludeRiskCharacteristics_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else 1.0
            deleted: false
          - name: calc_TierLossCost
            description: TierLossCost
            calculation: rt_InformationSecurityProtectionTier1LossCosts if (field_AggregateLimit_BOPInformationSecurityProtectionEndorsementDetail != '' and field_Deductible_BOPInformationSecurityProtectionEndorsementDetail != '') else 0.0 if (field_CoverageTierSelect_BOPInformationSecurityProtectionEndorsementDetail == 'Tier 1') else rt_InformationSecurityProtectionTier1and2LossCosts if (field_AggregateLimit_BOPInformationSecurityProtectionEndorsementDetail != '' and field_Deductible_BOPInformationSecurityProtectionEndorsementDetail != '') else 0.0 if (field_CoverageTierSelect_BOPInformationSecurityProtectionEndorsementDetail == 'Tier 1 and 2') else rt_InformationSecurityProtectionTier1and2and3LossCosts if (field_AggregateLimit_BOPInformationSecurityProtectionEndorsementDetail != '' and field_Deductible_BOPInformationSecurityProtectionEndorsementDetail != '') else 0.0 if (field_CoverageTierSelect_BOPInformationSecurityProtectionEndorsementDetail == 'Tier 1, 2 and 3') else 0.0
            deleted: false
          - name: calc_TierRate
            description: TierRate
            calculation: ((calc_TierLossCost_BOPInformationSecurityProtectionEndorsementDetail * calc_LCM_BOP))
            deleted: false
          - name: calc_businessIncomeAndExtraExpenseWaitingPeriodHoursNumeric
            description: businessIncomeAndExtraExpenseWaitingPeriodHoursNumeric
            calculation: '1'
            deleted: false
          - name: calc_WaitingPeriodFactor
            description: WaitingPeriodFactor
            calculation: rt_WaitingPeriodFactor if (field_BusinessIncomeAndExtraExpenseWaitingPeriodHours_BOPInformationSecurityProtectionEndorsementDetail == "8") else 1.0
            deleted: false
          - name: calc_ContractedSecurityBreachServicesFactor
            description: ContractedSecurityBreachServicesFactor
            calculation: rt_PreSecurityBreachServicesContractFactor if ((field_PreSecurityBreachServicesIDT911_BOPInformationSecurityProtectionEndorsementDetail == 'Yes' or field_PreSecurityBreachServicesOther1_BOPInformationSecurityProtectionEndorsementDetail != '' or field_PreSecurityBreachServicesOther2_BOPInformationSecurityProtectionEndorsementDetail != '') and (field_PostSecurityBreachServicesIDT911_BOPInformationSecurityProtectionEndorsementDetail == 'No' and field_PostSecurityBreachServicesOther1_BOPInformationSecurityProtectionEndorsementDetail == '' and field_PostSecurityBreachServicesOther2_BOPInformationSecurityProtectionEndorsementDetail == '')) else rt_PostSecurityBreachServicesContractFactor if ((field_PreSecurityBreachServicesIDT911_BOPInformationSecurityProtectionEndorsementDetail == 'No' and field_PreSecurityBreachServicesOther1_BOPInformationSecurityProtectionEndorsementDetail == '' and field_PreSecurityBreachServicesOther2_BOPInformationSecurityProtectionEndorsementDetail == '') and (field_PostSecurityBreachServicesIDT911_BOPInformationSecurityProtectionEndorsementDetail == 'Yes' or field_PostSecurityBreachServicesOther1_BOPInformationSecurityProtectionEndorsementDetail != '' or field_PostSecurityBreachServicesOther2_BOPInformationSecurityProtectionEndorsementDetail != '')) else rt_PreAndPostSecurityBreachServicesContractFactor if ((field_PreSecurityBreachServicesIDT911_BOPInformationSecurityProtectionEndorsementDetail == 'Yes' or field_PreSecurityBreachServicesOther1_BOPInformationSecurityProtectionEndorsementDetail != '' or field_PreSecurityBreachServicesOther2_BOPInformationSecurityProtectionEndorsementDetail != '') and (field_PostSecurityBreachServicesIDT911_BOPInformationSecurityProtectionEndorsementDetail == 'Yes' or field_PostSecurityBreachServicesOther1_BOPInformationSecurityProtectionEndorsementDetail != '' or field_PostSecurityBreachServicesOther2_BOPInformationSecurityProtectionEndorsementDetail != '')) else 1.0
            deleted: false
          - name: calc_TierPremium
            description: TierPremium
            calculation: ((((calc_TierRate_BOPInformationSecurityProtectionEndorsementDetail * calc_WaitingPeriodFactor_BOPInformationSecurityProtectionEndorsementDetail) * calc_ContractedSecurityBreachServicesFactor_BOPInformationSecurityProtectionEndorsementDetail) * calc_RiskCharacteristicTotalFactor_BOPInformationSecurityProtectionEndorsementDetail)) if (field_IncludeRiskCharacteristics_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else (((calc_TierRate_BOPInformationSecurityProtectionEndorsementDetail * calc_WaitingPeriodFactor_BOPInformationSecurityProtectionEndorsementDetail) * calc_ContractedSecurityBreachServicesFactor_BOPInformationSecurityProtectionEndorsementDetail))
            deleted: false
          - name: calc_Premium_1
            description: Premium
            calculation: ((calc_TierPremium_BOPInformationSecurityProtectionEndorsementDetail + field_SupplementalExtendedReportingPeriodPremium_BOPInformationSecurityProtectionEndorsementDetail) * calc_IRPMFactor_BOP) if (field_SupplementalExtendedReportingPeriod_BOPInformationSecurityProtectionEndorsementDetail == 'Yes') else (calc_TierPremium_BOPInformationSecurityProtectionEndorsementDetail * calc_IRPMFactor_BOP)
            deleted: false
          rate_tables:
