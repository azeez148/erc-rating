              value: Over 10 Years Old
              label: Over 10 Years Old
            - name: field_RoofAge_BOPStructure_10orUnderYearsOld
              value: 10 or Under Years Old
              label: 10 or Under Years Old
            - name: field_RoofAge_BOPStructure_Over5YearsOld
              value: Over 5 Years Old
              label: Over 5 Years Old
            - name: field_RoofAge_BOPStructure_5orUnderYearsOld
              value: 5 or Under Years Old
