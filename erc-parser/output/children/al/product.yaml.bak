            - name: field_CertificateLevel_BOPStructure_Bronze
              value: Bronze
              label: Bronze
            - name: field_CertificateLevel_BOPStructure_Silver
              value: Silver
              label: Silver
            - name: field_CertificateLevel_BOPStructure_Gold
              value: Gold
              label: Gold
