          - name: field_SubDecking_BOPStructure
            label: Does Building Have Sub-decking
            type: enum
            description: Does Building Have Sub-decking
            options:
            - name: field_SubDecking_BOPStructure_N/A
              value: N/A
              label: N/A
            - name: field_SubDecking_BOPStructure_Yes
