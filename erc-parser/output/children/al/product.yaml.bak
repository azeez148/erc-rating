              calculation: calc_BusnPrsnlPropRateRABOP_BOPClassification + calc_HurricaneLossCostsBPP_BOPClassification if (field_RABOPWanted_BOPClassification == 'Yes' and (field_RABOPType_BOPClassification == 'Smoothed' or field_RABOPType_BOPClassification == 'Unsmoothed')) else calc_BusnPrsnlPropRate_BOPClassification
              deleted: false
            - name: calc_busnPrsnlPropCreditFactor_1_BOPClassification
              description: busnPrsnlPropCreditFactor_1
              calculation: calc_sbl_BusnPrsnlPropCreditFactor_BOPALWindHailExclDirectDamage_busnPrsnlPropCreditFactor_1_BOPClassification if (calc_sbl_BOPALWindHailExclDirectDamage_busnPrsnlPropCreditFactor_1_BOPClassification) else 0.0
              deleted: false
            - name: calc_FinalBusnPrsnlPropRate_BOPClassification
              description: FinalBusnPrsnlPropRate
              calculation: ((((calc_bppRateToUse_1_BOPClassification * calc_LCM_BOPClassification) - (calc_busnPrsnlPropCreditFactor_1_BOPClassification * calc_LCM_BOPClassification)) - (((calc_WindstormOrHailExclBusnPrsnlPropFactor_BOPClassification * calc_LCM_BOPClassification) - (calc_busnPrsnlPropCreditFactor_1_BOPClassification * calc_LCM_BOPClassification)) * calc_WindMitigationDiscount_BOPStructure)) * calc_RateNumberFactorBPP_BOPClassification * calc_ConstructionTypeFactorBPP_BOPClassification * calc_BusnPersonalPropertyLimitOfInsuranceRelativityFactor_BOPClassification * calc_PublicProtectionFactorBPP_BOPClassification * calc_BldgCodeEffectivenessGradeFactor_BOPStructure * calc_SprinkleredFactorBPP_BOPClassification * calc_DedFactor_BOPLocation)
              deleted: false
            - name: calc_rABOPWanted_1_BOPTheftLimitationsCoverage
              description: rABOPWanted_1
              calculation: field_RABOPWanted_BOPClassification if (field_RABOPWanted_BOPClassification != None and field_RABOPWanted_BOPClassification != '') else '' if (calc_Limit_BOPTheftLimitationsCoverage > calc_InclddLimit_BOPTheftLimitationsCoverage) else ''
              deleted: false
            - name: calc_rABOPType_1_BOPTheftLimitationsCoverage
              description: rABOPType_1
              calculation: field_RABOPType_BOPClassification if (field_RABOPType_BOPClassification != None and field_RABOPType_BOPClassification != '') else '' if (calc_Limit_BOPTheftLimitationsCoverage > calc_InclddLimit_BOPTheftLimitationsCoverage) else ''
              deleted: false
            - name: calc_bppRateToUse_1_BOPTheftLimitationsCoverage
              description: bppRateToUse_1
              calculation: calc_BusnPrsnlPropRateRABOP_BOPClassification + calc_HurricaneLossCostsBPP_BOPClassification if (calc_BusnPrsnlPropRateRABOP_BOPClassification != None and calc_BusnPrsnlPropRateRABOP_BOPClassification != '') else 0.0 if (calc_rABOPWanted_1_BOPTheftLimitationsCoverage == 'Yes' and (calc_rABOPType_1_BOPTheftLimitationsCoverage == 'Smoothed' or calc_rABOPType_1_BOPTheftLimitationsCoverage == 'Unsmoothed')) else calc_BusnPrsnlPropRate_BOPClassification if (calc_BusnPrsnlPropRate_BOPClassification != None and calc_BusnPrsnlPropRate_BOPClassification != '') else 0.0 if (calc_Limit_BOPTheftLimitationsCoverage > calc_InclddLimit_BOPTheftLimitationsCoverage) else 0
              deleted: false
            - name: calc_RatingLimit_BOPTheftLimitationsCoverage
              description: RatingLimit
              calculation: ((calc_Limit_BOPTheftLimitationsCoverage - calc_InclddLimit_BOPTheftLimitationsCoverage) / 100.0) if (calc_Limit_BOPTheftLimitationsCoverage > calc_InclddLimit_BOPTheftLimitationsCoverage) else 0
              deleted: false
            - name: calc_Premium_BOPTheftLimitationsCoverage
              description: Premium
              calculation: (((calc_Factor_BOPTheftLimitationsCoverage * (calc_bppRateToUse_1_BOPTheftLimitationsCoverage * calc_LCM_BOPClassification)) * calc_RatingLimit_BOPTheftLimitationsCoverage) * calc_IRPMFactor_BOP) if (calc_Limit_BOPTheftLimitationsCoverage > calc_InclddLimit_BOPTheftLimitationsCoverage) else 0.0
              deleted: false
            rate_tables:
