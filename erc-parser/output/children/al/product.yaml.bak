            - name: bOPSpoilgCov
              label: BOPSpoilgCov
              description: Spoilage Coverage
              risk_name_template: '{{ riskType.label }} {{ number }}'
              fields: []
              calculations:
              - name: calc_PowerOutageFactor_BOPSpoilgCov
                description: PowerOutageFactor
                calculation: rt_PowerOutageFactor_PowerOutageFactor_BOPSpoilgCov if (field_CoverageType_BOPSpoilgCov == 'Power Outage') else 1.0
                deleted: false
              - name: calc_PowerOutageBreakdownFactor_BOPSpoilgCov
                description: PowerOutageBreakdownFactor
                calculation: rt_PowerOutageAndBreakdownFactor_PowerOutageBreakdownFactor_BOPSpoilgCov if (field_CoverageType_BOPSpoilgCov == 'Breakdown or Contamination and Power Outage') else 1.0
                deleted: false
              - name: calc_factor_1_BOPSpoilgCov
                description: factor_1
                calculation: calc_PowerOutageFactor_BOPSpoilgCov if (field_CoverageType_BOPSpoilgCov == 'Power Outage') else calc_PowerOutageBreakdownFactor_BOPSpoilgCov if (field_CoverageType_BOPSpoilgCov == 'Breakdown or Contamination and Power Outage') else 1.0
                deleted: false
              - name: calc_Premium_BOPSpoilgCov
                description: Premium
                calculation: (calc_IRPMFactor_BOP * ((field_Limit_BOPSpoilgCov / 100.0) * (calc_factor_1_BOPSpoilgCov * (calc_Rate_BOPSpoilgCov * calc_CommercialPropertyLCM_BOPClassification))))
                deleted: false
              rate_tables:
              - name: rt_PowerOutageFactor_PowerOutageFactor_BOPSpoilgCov
                label: PowerOutageFactor
                sources:
                - name: field_RatingTerritory_BOPLocation
                  resolution: map
                data_file: PowerOutageFactor.json
                deleted: false
              - name: rt_PowerOutageAndBreakdownFactor_PowerOutageBreakdownFactor_BOPSpoilgCov
                label: PowerOutageAndBreakdownFactor
                sources:
                - name: field_RatingTerritory_BOPLocation
                  resolution: map
                data_file: PowerOutageAndBreakdownFactor.json
                deleted: false
              items:
              - name: bOPSpoilgCov
                label: Spoilage Coverage
                type: coverage
                presence: mandatory
                variables: []
                premium:
                  name: premium
                  calculation: calc_Premium_BOPSpoilgCov
                  deleted: false
                limits: []
                deleted: false
