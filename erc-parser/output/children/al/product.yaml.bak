            deleted: false
          - name: calc_WindMitigationDiscount_BOPStructure
            description: WindMitigationDiscount
            calculation: rt_WindMitigationDiscountCommercialOlderRoof_WindMitigationDiscount_BOPStructure if (field_RatingTerritory_BOPLocation != '' and field_CertificateLevel_BOPStructure != '') else 0.0 if (field_OccupancyClass_BOPStructure == 'Commercial') else rt_WindMitigationDiscountResidentialOlderRoof_WindMitigationDiscount_BOPStructure if (field_RatingTerritory_BOPLocation != '' and field_CertificateLevel_BOPStructure != '') else 0.0 if (field_OccupancyClass_BOPStructure == 'Residential') else 1.0 if (field_WindstormMitigationDiscountApplies_BOPStructure == 'Yes' and ((field_RoofMaterial_BOPStructure == 'Metal' and field_RoofAge_BOPStructure == 'Over 10 Years Old') or (field_RoofMaterial_BOPStructure == 'Non-Metal' and field_RoofAge_BOPStructure == 'Over 5 Years Old'))) else rt_WindMitigationDiscountCommercialNewerRoof_WindMitigationDiscount_BOPStructure if (field_RatingTerritory_BOPLocation != '' and field_CertificateLevel_BOPStructure != '') else 0.0 if (field_OccupancyClass_BOPStructure == 'Commercial') else rt_WindMitigationDiscountResidentialNewerRoof_WindMitigationDiscount_BOPStructure if (field_RatingTerritory_BOPLocation != '' and field_CertificateLevel_BOPStructure != '') else 0.0 if (field_OccupancyClass_BOPStructure == 'Residential') else 1.0 if (field_WindstormMitigationDiscountApplies_BOPStructure == 'Yes' and ((field_RoofMaterial_BOPStructure == 'Metal' and field_RoofAge_BOPStructure == '10 or Under Years Old' and field_SubDecking_BOPStructure != 'No') or (field_RoofMaterial_BOPStructure == 'Non-Metal' and field_RoofAge_BOPStructure == '5 or Under Years Old'))) else rt_WindMitigationDiscountCommercialNoSubdecking_WindMitigationDiscount_BOPStructure if (field_RatingTerritory_BOPLocation != '' and field_CertificateLevel_BOPStructure != '') else 0.0 if (field_WindstormMitigationDiscountApplies_BOPStructure == 'Yes' and (field_RoofMaterial_BOPStructure == 'Metal' and field_RoofAge_BOPStructure == '10 or Under Years Old' and field_SubDecking_BOPStructure == 'No')) else 0.0 if (calc_WindstormOrHailExclBldgFactor_BOPStructure == 0.0 and field_WindstormMitigationDiscountApplies_BOPStructure == 'No') else 1.0
            deleted: false
          - name: calc_FinalBuildingRate_BOPStructure
            description: FinalBuildingRate
            calculation: (calc_RateNumberFactorBldg_BOPStructure * calc_ConstructionTypeFactorBldg_BOPStructure * calc_BldgLimitOfInsuranceRelativityFactor_BOPStructure * calc_PublicProtectionFactorBldg_BOPStructure * calc_BldgCodeEffectivenessGradeFactor_BOPStructure * calc_SprinkleredFactorBldg_BOPStructure * calc_DedFactor_BOPStructure * (((calc_buildingRateToUse_1_BOPStructure * calc_LCM_BOPStructure) - (calc_bldgCreditFactor_1_BOPStructure * calc_LCM_BOPStructure)) - (((calc_WindstormOrHailExclBldgFactor_BOPStructure * calc_LCM_BOPStructure) - (calc_bldgCreditFactor_1_BOPStructure * calc_LCM_BOPStructure)) * calc_WindMitigationDiscount_BOPStructure)))
            deleted: false
          - name: calc_sbl_BOPWindstormOrHailExclusion_WindstormOrHailExclBusnPrsnlPropFactor_BOPClassification
            calculation: ( bc.risk.descendants(1).filter(type__name='bOPWindstormOrHailExclusion').count() ) > 0
            deleted: false
          - name: calc_sbl_BOPALWindHailExclDirectDamage_busnPrsnlPropCreditFactor_1_BOPClassification
            calculation: ( bc.risk.descendants(1).filter(type__name='bOPALWindHailExclDirectDamage').count() ) > 0
            deleted: false
          - name: calc_sbl_BusnPrsnlPropCreditFactor_BOPALWindHailExclDirectDamage_busnPrsnlPropCreditFactor_1_BOPClassification
            calculation: ( bc.risk.descendants(1).filter(type__name='bOPALWindHailExclDirectDamage').get(bc.calculations.calc_BusnPrsnlPropCreditFactor_BOPALWindHailExclDirectDamage) if bc.risk.descendants(1).filter(type__name='bOPALWindHailExclDirectDamage').count() > 0 else 0 )
            deleted: false
