          - name: calc_HurricaneLossCostsBuilding_BOPStructure
            description: HurricaneLossCostsBuilding
            calculation: rt_HurricaneLossCostsBuilding_HurricaneLossCostsBuilding_BOPStructure if (field_RABOPWanted_BOPStructure == 'Yes' and (field_RABOPType_BOPStructure == 'Smoothed' or field_RABOPType_BOPStructure == 'Unsmoothed') and field_RatingTerritory_BOPLocation != '') else 0.0
            deleted: false
          - name: calc_WindstormOrHailExclBldgFactor_BOPStructure
            description: WindstormOrHailExclBldgFactor
            calculation: rt_WindstormOrHailExclBldgFactor_WindstormOrHailExclBldgFactor_BOPStructure if (( bc.risk.descendants(1).filter(type__name='bOPWindstormOrHailExclusion').count() ) > 0.0 or field_WindstormMitigationDiscountApplies_BOPStructure == 'Yes') else 0.0
            deleted: false
          - name: calc_buildingRateToUse_1_BOPStructure
